# The two ends of the ctest fixture in WoweeTestSandbox.cmake.
#
#   MODE=setup  empty SANDBOX, make each sandboxed test's folders (listed in
#               SANDBOX.tests.txt), and record the player's folders (ROOTS,
#               separated by |) - name, size and SHA1 of every file.
#   MODE=check  record them again; any file added, removed or changed fails
#               the run and is named. Nothing in ROOTS is ever written.

string(REPLACE "|" ";" _roots "${ROOTS}")
set(_snapshot "${SANDBOX}.user_roots.txt")

function(_wowee_snapshot out)
    set(_lines "")
    foreach(_root IN LISTS _roots)
        if(NOT IS_DIRECTORY "${_root}")
            list(APPEND _lines "${_root}|absent")
            continue()
        endif()
        file(GLOB_RECURSE _files LIST_DIRECTORIES false "${_root}/*")
        list(SORT _files)
        foreach(_f IN LISTS _files)
            if(IS_SYMLINK "${_f}")
                continue()
            endif()
            file(SIZE "${_f}" _size)
            file(SHA1 "${_f}" _sha)
            list(APPEND _lines "${_f}|${_size}|${_sha}")
        endforeach()
    endforeach()
    set(${out} "${_lines}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "setup")
    file(REMOVE_RECURSE "${SANDBOX}")
    file(MAKE_DIRECTORY "${SANDBOX}")
    if(EXISTS "${SANDBOX}.tests.txt")
        file(STRINGS "${SANDBOX}.tests.txt" _tests)
        foreach(_t IN LISTS _tests)
            if(_t STREQUAL "")
                continue()
            endif()
            file(MAKE_DIRECTORY "${SANDBOX}/${_t}/AppData/Roaming" "${SANDBOX}/${_t}/AppData/Local"
                                "${SANDBOX}/${_t}/home" "${SANDBOX}/${_t}/config")
        endforeach()
    endif()
    _wowee_snapshot(_now)
    string(REPLACE ";" "\n" _text "${_now}")
    file(WRITE "${_snapshot}" "${_text}\n")
elseif(MODE STREQUAL "check")
    if(NOT EXISTS "${_snapshot}")
        message(FATAL_ERROR "no record of the player's folders from before the run (${_snapshot})")
    endif()
    file(STRINGS "${_snapshot}" _before)
    _wowee_snapshot(_after)
    set(_changed "")
    foreach(_l IN LISTS _after)
        if(NOT _l IN_LIST _before)
            string(REGEX MATCH "^[^|]+" _p "${_l}")
            list(APPEND _changed "  written: ${_p}")
        endif()
    endforeach()
    foreach(_l IN LISTS _before)
        if(NOT _l IN_LIST _after)
            string(REGEX MATCH "^[^|]+" _p "${_l}")
            list(APPEND _changed "  before the run: ${_p}")
        endif()
    endforeach()
    if(_changed)
        list(REMOVE_DUPLICATES _changed)
        string(REPLACE ";" "\n" _text "${_changed}")
        message(FATAL_ERROR
            "A test changed the player's own wowee folders (a client the player "
            "ran meanwhile would do the same - then run again):\n${_text}")
    endif()
    message(STATUS "player's wowee folders untouched (${_roots})")
else()
    message(FATAL_ERROR "MODE must be setup or check")
endif()
