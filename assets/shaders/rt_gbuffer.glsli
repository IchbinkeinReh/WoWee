// The G-buffer the opaque surfaces write beside their colour while the ray
// traced lighting is on (docs/deferred_rt_design.md), and how the passes after
// them read it back. Mirrored for the unit tests in rt_gbuffer_pack.hpp.
//
// A surface keeps computing its colour as the client does, in its own shader:
// the textures, the stages, the vertex and baked light, the fog. What it cannot
// know while it is drawn is what the trace will find, so it draws with the
// traced terms at their neutral values - the sun's visibility 1 (the shadow map
// alone shades it), no occlusion, no point lights, the baked colour unshaded -
// and writes down here how its colour depends on them. Every lighting formula
// of the forward shaders has, per channel, the same shape:
//
//     C = C0 + G (r - 1) - r max(0, Y (1 - ao) - E) + Kp P
//
// r: the sun's shadow scale over the one C0 was drawn with, times the baked
// shade; ao: the occlusion; P: the point lights' light (rt_lighting.glsli).
// G is what of C0 those two scale, Y and E the occlusion's slope and what the
// clamps cut off (a chain of min(1, ...) over positive affine steps folds to a
// single knee, so this is the formula, not an approximation of it), and Kp
// what the point lights' light is multiplied by on its way to the screen.
//
// Stored relative to C0 they fit in a byte each. Two R16G16B16A16_UNORM
// targets, eight 16-bit words:
//     0  normal (octahedral) u, 10 bits | knee r, 6
//     1  normal v, 10 | knee g, 6
//     2  the shadow map's light, 8 | flags, 4
//     3  g.r | g.g          (g = G / C0)
//     4  g.b | occ.r        (occ = (Y - E) / C0, the most the occlusion takes)
//     5  occ.g | occ.b
//     6  kp.r | kp.g        (kp = Kp / 2)
//     7  kp.b | knee b, 6   (knee = E / Y)
// A cleared texel is no surface of the tracing's: the sky, grass, a debug view.

const uint RT_GB_VALID = 1u;       // a surface the traced terms apply to
const uint RT_GB_SUN = 2u;         // its colour is scaled by the sun's shadow
const uint RT_GB_BAKED = 4u;       // its colour is baked light: the lamps' shade
                                   // scales it, and only the other lights add
const uint RT_GB_LIFT_AFTER = 8u;  // the edge-on lift after the traced shadow
                                   // (character.frag), not before it

vec2 rtOctEncode(vec3 n) {
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    vec2 e = n.xy;
    if (n.z < 0.0) e = (1.0 - abs(n.yx)) * vec2(e.x >= 0.0 ? 1.0 : -1.0, e.y >= 0.0 ? 1.0 : -1.0);
    return e;
}

vec3 rtOctDecode(vec2 e) {
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

// What a surface knows of how its colour depends on the traced terms, in the
// colour's own units (after the stages and the fog).
struct RtSurface {
    vec3 normal;   // the normal it is lit by
    float map;     // the shadow map's light it was drawn with
    uint flags;
    vec3 g;        // G
    vec3 occY;     // Y
    vec3 occE;     // E
    vec3 kp;       // Kp
};

// Nothing traced applies: the colour is left as it is.
RtSurface rtSurfaceNone() {
    return RtSurface(vec3(0.0, 0.0, 1.0), 1.0, 0u, vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0));
}

// The occlusion's part of a light the Diffuse programs clamp,
// min(cap, a * ao + d): its slope and what the cap cuts off with ao at 1.
// The rest of the chain scales both (rtSurfaceScale).
void rtSurfaceOcclusion(inout RtSurface s, vec3 a, vec3 d, vec3 cap) {
    s.occY = a;
    s.occE = max(a + d - cap, vec3(0.0));
}

// Everything after the light - the texture stages, a pass's doubling, the
// fog's share - multiplies G, Y, E and Kp alike.
void rtSurfaceScale(inout RtSurface s, vec3 m) {
    s.g *= m;
    s.occY *= m;
    s.occE *= m;
    s.kp *= m;
}

// Two surfaces drawn as one, a * t + b * (1 - t) - a WMO transition batch's
// two passes. Their flags together: where only one pass is shadowed or baked
// light, the other's part is taken as being so too.
RtSurface rtSurfaceMix(RtSurface a, RtSurface b, float t) {
    RtSurface s = b;
    s.flags = a.flags | b.flags;
    s.g = mix(b.g, a.g, t);
    s.occY = mix(b.occY, a.occY, t);
    s.occE = mix(b.occE, a.occE, t);
    s.kp = mix(b.kp, a.kp, t);
    return s;
}

uint rtByte(float v) { return uint(clamp(v, 0.0, 1.0) * 255.0 + 0.5); }
uint rtBits6(float v) { return uint(clamp(v, 0.0, 1.0) * 63.0 + 0.5); }
uint rtBits10(float v) { return uint(clamp(v, 0.0, 1.0) * 1023.0 + 0.5); }

// The two targets for a surface whose colour came out as c0.
void rtSurfacePack(RtSurface s, vec3 c0, out vec4 gb0, out vec4 gb1) {
    vec2 oct = rtOctEncode(s.normal) * 0.5 + 0.5;
    vec3 inv = vec3(c0.r > 1e-5 ? 1.0 / c0.r : 0.0, c0.g > 1e-5 ? 1.0 / c0.g : 0.0,
                    c0.b > 1e-5 ? 1.0 / c0.b : 0.0);
    vec3 g = s.g * inv;
    vec3 occ = max(s.occY - s.occE, vec3(0.0)) * inv;
    vec3 knee = vec3(s.occY.r > 1e-6 ? s.occE.r / s.occY.r : 1.0,
                     s.occY.g > 1e-6 ? s.occE.g / s.occY.g : 1.0,
                     s.occY.b > 1e-6 ? s.occE.b / s.occY.b : 1.0);
    vec3 kp = s.kp * 0.5;
    uint w0 = rtBits10(oct.x) | (rtBits6(knee.r) << 10);
    uint w1 = rtBits10(oct.y) | (rtBits6(knee.g) << 10);
    uint w2 = rtByte(s.map) | ((s.flags & 15u) << 8);
    uint w3 = rtByte(g.r) | (rtByte(g.g) << 8);
    uint w4 = rtByte(g.b) | (rtByte(occ.r) << 8);
    uint w5 = rtByte(occ.g) | (rtByte(occ.b) << 8);
    uint w6 = rtByte(kp.r) | (rtByte(kp.g) << 8);
    uint w7 = rtByte(kp.b) | (rtBits6(knee.b) << 8);
    gb0 = vec4(w0, w1, w2, w3) / 65535.0;
    gb1 = vec4(w4, w5, w6, w7) / 65535.0;
}

// The same, read back, relative to C0.
struct RtGbuf {
    vec3 normal;
    float map;
    uint flags;
    vec3 g;      // G / C0
    vec3 occ;    // (Y - E) / C0
    vec3 knee;   // E / Y
    vec3 kp;     // Kp
};

uvec4 rtWords(vec4 v) { return uvec4(v * 65535.0 + 0.5); }
float rtUnbyte(uint w, uint shift) { return float((w >> shift) & 255u) / 255.0; }

uint rtGbufFlags(vec4 gb0) { return (rtWords(gb0).z >> 8) & 15u; }

// The normal the surface is lit by.
vec3 rtGbufShadingNormal(vec4 gb0) {
    uvec4 a = rtWords(gb0);
    vec2 oct = vec2(float(a.x & 1023u), float(a.y & 1023u)) / 1023.0 * 2.0 - 1.0;
    return rtOctDecode(oct);
}

RtGbuf rtGbufUnpack(vec4 gb0, vec4 gb1) {
    uvec4 a = rtWords(gb0);
    uvec4 b = rtWords(gb1);
    RtGbuf r;
    r.normal = rtGbufShadingNormal(gb0);
    r.knee = vec3(float(a.x >> 10), float(a.y >> 10), float(b.w >> 8)) / 63.0;
    r.map = rtUnbyte(a.z, 0u);
    r.flags = (a.z >> 8) & 15u;
    r.g = vec3(rtUnbyte(a.w, 0u), rtUnbyte(a.w, 8u), rtUnbyte(b.x, 0u));
    r.occ = vec3(rtUnbyte(b.x, 8u), rtUnbyte(b.y, 0u), rtUnbyte(b.y, 8u));
    r.kp = vec3(rtUnbyte(b.z, 0u), rtUnbyte(b.z, 8u), rtUnbyte(b.w, 0u)) * 2.0;
    return r;
}

// What the occlusion ao takes of C0, as a fraction of it: occ, the most it
// can take (ao 0), once 1 - ao passes the knee.
vec3 rtOcclusionLoss(RtGbuf s, float ao) {
    vec3 x = vec3(1.0 - ao);
    vec3 span = max(vec3(1.0) - s.knee, vec3(1e-3));
    return s.occ * clamp((x - s.knee) / span, vec3(0.0), vec3(1.0));
}
