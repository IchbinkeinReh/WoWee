// The ray traced water (water.frag built with RT_WATER, the "Ray traced
// water" setting): the surface's reflection and what lies under it traced
// through the scene the lighting traces (rt_trace_hw.glsli or
// rt_trace_sw.glsli, set 3), rather than read off a planar reflection and a
// screen-space offset. Mirrored in rt_water.hpp, which the tests check.
//
// A calm water surface is a mirror and a refractor, so each pixel's two rays
// are fixed by its wave normal and there is no noise to gather over frames:
// one ray each way, every frame, at the pixel's own wave normal - the
// enhanced water's waves are what bend both.
//
// - Reflection: reflect(-V, N), traced up to rtWater.z yards. A hit is lit
//   by its triangle's colour under the ambient and, past one shadow ray,
//   the sun; the air between is the zone's distance fog. A miss is the sky,
//   its horizon and zenith colours (rtSkyHorizon, rtSkyTop).
// - Refraction: refract(-V, N, 1 / 1.333), traced up to rtWater2.x yards.
//   The light that comes back up through the water is the bed's, taken from
//   the frame drawn under the water where the hit is on screen there and
//   matches it (its depth), and from the hit's own colour lit where it is
//   not; over the path, Beer-Lambert absorption, exp(-sigma x d), and what
//   the water scatters in, its body colour lit, by 1 - exp(-sigma x d). The
//   sun on the bed is held back by the water it came down through (rtwSunDown).
//   No hit within reach: all of it the water's own.
// - The two by Schlick's Fresnel at the 1.333 interface (F0 0.02); from
//   under the surface past the critical angle, all reflection.

#include "rt_trace_detail.glsli"

const float RTW_IOR = 1.333;
const float RTW_F0 = 0.02;

float rtwFresnel(float cosTheta) {
    float c = clamp(1.0 - cosTheta, 0.0, 1.0);
    return RTW_F0 + (1.0 - RTW_F0) * c * c * c * c * c;
}

// The sky a reflected ray that leaves the scene meets.
vec3 rtwSky(vec3 dir) {
    float up = clamp(dir.z, 0.0, 1.0);
    return mix(rtSkyHorizon.rgb, rtSkyTop.rgb, sqrt(up));
}

// A traced hit's colour lit: its triangle's under the ambient, and the sun
// where `sunVis` lets it through - the sum held to 1, as terrain.frag and
// the models' shaders hold theirs.
vec3 rtwLitHit(vec4 surface, vec3 n, vec3 toSun, vec3 sunVis) {
    vec3 light = ambientColor.rgb + lightColor.rgb * max(dot(n, toSun), 0.0) * sunVis;
    return surface.rgb * clamp(light, 0.0, 1.0);
}

// The way the sun goes down through the surface, up toward it from the bed.
vec3 rtwSunUnderwater() {
    return -refract(-normalize(rtSunRay.xyz), vec3(0.0, 0.0, 1.0), 1.0 / RTW_IOR);
}

// How far from `bed`, `depth` under the surface, the sun has come through water.
float rtwSunPath(float depth) {
    return depth / max(rtwSunUnderwater().z, 0.2);
}

// The frame drawn under the water (SceneColor) where a traced hit is on
// screen and is what that pixel shows: its projected depth matches the
// frame's, and the face hit looks toward the camera - the far side of a
// wall or the underside of a bridge deck, which a reflection meets and the
// camera does not see, sits within the depth tolerance of the near side.
// That colour is the surface as drawn - textured, lit, shadowed, fogged -
// rather than its triangle's one colour.
//
// Returns how much of the frame's colour to take: 1 well inside the screen,
// falling to 0 over its outer 3% so the change to the traced colour where a
// hit leaves it is not a line. 0 for no match.
const float RTW_BED_SHORE = 0.5;  // yards under the surface the ground's own sun has taken over by
bool rtwScreenReuse = true;  // off for the traced-only debug view and interior water
// (Interior water's mirror reads the capture by its own rules: rtwMirrorSeen.)
const float RTW_MIRROR_EDGE = 0.12;   // of the screen, the fade at its edge
const float RTW_MIRROR_REACH = 0.02;  // of its height, how far round a point the depth is asked
float rtwOnScreen(vec3 hit, vec3 hitNormal, out vec3 color) {
    color = vec3(0.0);
    if (!rtwScreenReuse || push.sceneValid < 0.5) return 0.0;
    if (dot(hitNormal, viewPos.xyz - hit) <= 0.0) return 0.0;
    vec4 clip = projection * view * vec4(hit, 1.0);
    if (clip.w < 0.1) return 0.0;
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    vec2 edge = min(uv, 1.0 - uv);
    float w = smoothstep(0.0, 0.03, min(edge.x, edge.y));
    if (w <= 0.0) return 0.0;
    float scene = linearizeDepth(texture(SceneDepth, uv).r, push.depthRange.x, push.depthRange.y);
    if (abs(scene - clip.w) >= max(0.5, 0.03 * clip.w)) return 0.0;
    color = texture(SceneColor, uv).rgb;
    return w;
}

// The capture's colour for a mirror over a building's interior water, and how
// far it can be trusted: only a point standing clear of `surfaceZ` whose depth
// agrees with the capture's. Every test is a fade, and the depth's is taken over
// the taps round the point, so what is rejected goes to the water's body over a
// distance and not at a line: the edge of something in front of the point, the
// screen's, the point's face turning away.
float rtwMirrorDepthAgrees(vec2 uv, float depth, float tolerance) {
    float scene = linearizeDepth(texture(SceneDepth, uv).r, push.depthRange.x, push.depthRange.y);
    return 1.0 - smoothstep(tolerance, 2.0 * tolerance, abs(scene - depth));
}
float rtwMirrorSeen(vec3 hit, vec3 hitNormal, float surfaceZ, out vec3 color) {
    color = vec3(0.0);
    if (!(rtWater.y < 2.5) || push.sceneValid < 0.5) return 0.0;
    vec4 clip = projection * view * vec4(hit, 1.0);
    if (clip.w < 0.1) return 0.0;
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    vec2 edge = min(uv, 1.0 - uv);
    float seen = smoothstep(0.0, RTW_MIRROR_EDGE, min(edge.x, edge.y));
    seen *= smoothstep(0.0, 0.2, dot(hitNormal, normalize(viewPos.xyz - hit)));
    seen *= smoothstep(0.05, 0.4, hit.z - surfaceZ);
    if (seen <= 0.0) return 0.0;
    float tolerance = max(0.25, 0.01 * clip.w);
    float agree = rtwMirrorDepthAgrees(uv, clip.w, tolerance);
    vec2 reach = vec2(RTW_MIRROR_REACH * push.screenSize.y / push.screenSize.x, RTW_MIRROR_REACH);
    for (int i = 0; i < 8; ++i) {
        float a = float(i) * 0.7853982;
        vec2 ring = vec2(cos(a), sin(a)) * reach;
        agree += rtwMirrorDepthAgrees(uv + ring, clip.w, tolerance);
        agree += rtwMirrorDepthAgrees(uv + ring * 0.5, clip.w, tolerance);
    }
    color = texture(SceneColor, uv).rgb;
    return seen * smoothstep(0.1, 0.9, agree / 17.0);
}

// What the frame drawn under the water shows at the surface point `p`'s own
// pixel, when that is something below the surface - the bed seen straight
// down, rather than something in front of the water there.
bool rtwBehindSurface(vec3 p, out vec3 color) {
    color = vec3(0.0);
    if (push.sceneValid < 0.5) return false;
    vec4 clip = projection * view * vec4(p, 1.0);
    if (clip.w < 0.1) return false;
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return false;
    float scene = linearizeDepth(texture(SceneDepth, uv).r, push.depthRange.x, push.depthRange.y);
    if (scene < clip.w + 0.1) return false;
    color = texture(SceneColor, uv).rgb;
    return true;
}

// The width in yards of what one pixel's ray covers `t` past the surface at
// `origin`: the pixel's angle over the whole path from the camera, doubled
// for the waves' spread of it. Picks the level a hit's texture is read at.
float rtwFootprint(vec3 origin, float t) {
    float pixelAngle = 2.0 / (projection[1][1] * float(textureSize(SceneDepth, 0).y));
    return (length(viewPos.xyz - origin) + t) * pixelAngle * 2.0;
}

// How much of the last reflection is the surface as drawn. A room's traced rock
// has only its bare texture, not the light painted on it, so over a building's
// interior water only that much of the mirror is shown: past it the water keeps
// its own colour rather than a guess at what is off screen.
float rtwReflectionSeen = 0.0;

// The reflection along `dir` from `origin`.
vec3 rtwReflection(vec3 origin, vec3 dir, vec3 toSun, inout uint rng) {
    float t;
    vec3 hn;
    vec4 hs;
    float reach = max(rtWater.z, 1.0);
    rtwReflectionSeen = 0.0;
    if (!rtClosest(origin, dir, reach, rng, t, hn, hs)) {
        return rtwSky(dir);
    }
    vec3 hit = origin + dir * t;
    vec3 shown;
    if (push.interiorFog > 0.5) {
        rtwReflectionSeen = rtwMirrorSeen(hit, hn, origin.z, shown);
        return shown;
    }
    // Fogged already, over the camera's distance to it.
    float onScreen = rtwOnScreen(hit, hn, shown);
    rtwReflectionSeen = onScreen;
    if (onScreen >= 1.0) return shown;
    bool unit;
    // Shadowed as the land is, by the sun its shadows follow (rtSunRay).
    vec3 sunRay = normalize(rtSunRay.xyz);
    float vis = dot(hn, sunRay) > 0.0 && !rtOccludedBy(hit + hn * 0.05, sunRay, 400.0, rng, unit) ? 1.0 : 0.0;
    hs.rgb = rtHitColor(origin, dir, t, rtwFootprint(origin, t), hs.rgb);
    vec3 c = rtwLitHit(hs, hn, toSun, vec3(vis));
    // The air between the surface and what it shows.
    float haze = clamp(t / max(fogParams.y, 1.0), 0.0, 1.0);
    return mix(mix(c, fogColor.rgb, haze), shown, onScreen);
}

// How deep under the surface the bed the last refracted ray met lies, when it
// met the bed or anything else standing in the water but a unit: -1 for none
// (water.frag: the water's own colour over the path and the shore's masks).
float rtwBedDepth = -1.0;

// What comes up through the water along the refracted `dir` from `origin`:
// rgb, and in a the path length the water absorbed over (rtWater2.x where
// nothing was met).
vec4 rtwRefraction(vec3 origin, vec3 dir, vec3 toSun, vec3 sigma, vec3 scatterColor, inout uint rng,
                   out bool bedFromScreen) {
    bedFromScreen = false;
    float t;
    vec3 hn;
    vec4 hs;
    float reach = max(rtWater2.x, 1.0);
    vec3 bed = vec3(0.0);
    float d = reach;
    rtwBedDepth = -1.0;
    // Seen from above, every ray under a wader leaves the surface inside the
    // wader's box, and a ray from inside a unit's box passes the unit by: the
    // body under the water was not there to meet.
    rtMeetsOwnGroup = true;
    bool met = rtClosest(origin, dir, reach, rng, t, hn, hs);
    rtMeetsOwnGroup = false;
    if (met) {
        d = t;
        vec3 hit = origin + dir * t;
        // The frame under the water has the bed as drawn - textured, lit,
        // shadowed - wherever the hit is on screen there and is what that
        // pixel shows; the hit's own colour only where it is not.
        vec3 shown;
        float onScreen = rtwOnScreen(hit, hn, shown);
        // The ground under the water takes its sun here, not from the frame. The
        // frame lights it as dry land in a hollow: a low sun's ray runs straight
        // on through the bank, and the whole bed of a pond lay in the bank's
        // shadow. The sun bends down at the surface, so what can stop it is what
        // stands over the point it came in at, and the water it came through.
        // That is the one sun on it, by the triangle's colour, so nothing is lit
        // twice; near the shore, where no bank can stand between, it hands over
        // to the frame, which the land beside it is.
        // Lit as level: its triangles' own normals, each a flat face, lit the bed
        // facet by facet, bands of light and shade with straight edges between.
        bool ground = (rtInstances[rtHitInstance].flags & RT_MESH_TERRAIN) != 0u;
        float depth = max(origin.z - hit.z, 0.0);
        if (rtInstances[rtHitInstance].group == 0u) rtwBedDepth = depth;
        float tracedShare = ground ? smoothstep(0.0, RTW_BED_SHORE, depth) : 0.0;
        vec3 traced = vec3(0.0);
        if (onScreen < 1.0 || tracedShare > 0.0) {
            hs.rgb = rtHitColor(origin, dir, t, rtwFootprint(origin, t), hs.rgb);
            vec3 sunRay = normalize(rtSunRay.xyz);
            float sunPath = rtwSunPath(depth);
            vec3 entry = hit + rtwSunUnderwater() * sunPath;
            float vis = sunRay.z > 0.0 && !rtOccluded(entry + vec3(0.0, 0.0, 0.1), sunRay, 400.0, rng) ? 1.0 : 0.0;
            traced = rtwLitHit(hs, ground ? vec3(0.0, 0.0, 1.0) : hn, toSun, exp(-sigma * sunPath) * vis);
        }
        bed = shown;
        if (onScreen < 1.0) {
            // Not on screen as itself: off the edge, or behind something
            // nearer - most often the swimmer, whose body covers where the
            // bed beyond its outline projects. The traced colour there is lit
            // apart from the frame and read as a pale cut-out of the swimmer on
            // the bed, a body length beyond it. What the frame shows straight
            // under this pixel is the same bed, without the bend.
            vec3 under;
            bed = mix(rtwBehindSurface(origin, under) ? under : traced, shown, onScreen);
        }
        bed = mix(bed, traced, tracedShare);
        bedFromScreen = onScreen >= 1.0;
    }
    vec3 transmit = exp(-sigma * d);
    return vec4(bed * transmit + scatterColor * (1.0 - transmit), d);
}
