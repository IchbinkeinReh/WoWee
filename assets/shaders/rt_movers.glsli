// What moves on its own this frame (RtMover, RtLighting::FrameInputs::movers):
// units, what they carry, doors, chests, lifts and ships. Read by the passes
// that need to know which G-buffer texels are a mover's and where they were a
// frame earlier (rt_prepare, rt_temporal). Include after rt_common.glsli.

// Must match RtLighting::kMaxMovers.
#define RT_MAX_MOVERS 500

// Must match RtMoverGPU in rt_lighting.cpp.
struct RtMover {
    vec4 lo;         // the box this frame; w the longest history its texels keep
    vec4 hi;
    vec4 motion[3];  // rows of the 3x4 taking a point of it now to where it was
    vec4 rect;       // the trace texels the box covers: min xy, max xy
};
layout(std430, set = 0, binding = 13) readonly buffer RtMovers { RtMover rtMovers[]; };

int rtMoverCount() { return int(pass.misc.z + 0.5); }

// Where a point of mover i was a frame earlier, and a direction of it.
vec3 rtMoverPrev(int i, vec3 p) {
    vec4 q = vec4(p, 1.0);
    return vec3(dot(rtMovers[i].motion[0], q), dot(rtMovers[i].motion[1], q), dot(rtMovers[i].motion[2], q));
}
vec3 rtMoverPrevDir(int i, vec3 d) {
    return vec3(dot(rtMovers[i].motion[0].xyz, d), dot(rtMovers[i].motion[1].xyz, d),
                dot(rtMovers[i].motion[2].xyz, d));
}
