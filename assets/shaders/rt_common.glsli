// Shared by the ray traced lighting passes (rt_*.comp.glsl, rt_apply).
//
// Set 0 is the lighting pass's own: this block, the scene depth, the
// G-buffer the opaque surfaces wrote (rt_gbuffer.glsli) and the working
// images. Set 1 is the scene (rt_trace_sw.glsli / rt_trace_hw.glsli).
// Must match RtPassData in rt_lighting.cpp.

#include "rt_gbuffer.glsli"
#include "rt_upsample.glsli"

layout(set = 0, binding = 0) uniform RtPassData {
    mat4 invViewProj;    // this frame: NDC -> world
    mat4 prevViewProj;   // last frame: world -> clip, for reprojection
    vec4 cameraPos;      // xyz; w = frame counter
    vec4 prevCameraPos;  // xyz
    vec4 sunDir;         // xyz toward the sun; w = tan of its angular radius
    vec4 sunColor;       // rgb; w = 1 when the sun is above the horizon
    vec4 skyColor;       // rgb radiance of a ray that escapes
    vec4 params;         // x = mode (1 shadows, 2 +AO, 3 +probe GI), y = AO
                         // radius, z = how many point lights, w = shadow ray length
    vec4 extent;         // xy = trace size, zw = 1 / trace size
    vec4 sceneExtent;    // xy = scene depth size, zw = 1 / size
    vec4 misc;           // x = 1 when the acceleration structure holds anything,
                         // y = 1 when last frame's slot holds history
    mat4 invViewProjRel; // this frame: NDC -> world less the camera position
    vec4 unitMap;        // xyz the shadow map's centre, w the radius it draws
                         // the units' sun shadows within (0: none)
    // The Debug Graphics strengths, as the forward shaders take them from the
    // per-frame block (rt_lighting.glsli), for the apply pass.
    vec4 tune;           // x shadow darkness, y traced sun shadow, z occlusion,
                         // w point lights
    vec4 tune2;          // x baked-lamp shadows, y point lights' shadows,
                         // z the debug view (0 none), w 1: the ground's and
                         // the buildings' point shadows whole (rt_trace)
    vec4 tune3;          // x inside, what of a baked colour shows where no
                         // point light reaches; y the light where all of it
                         // does (rtInteriorShade); z the most light the
                         // traced lights add, 0 no limit (rtCapLight)
    vec4 rays;           // rays a pixel, 1-5: x toward the sun, y occlusion,
                         // z toward a point light; w a probe's rays a direction
    // The probe volume (rt_gi.glsli), read only by the probe passes.
    vec4 giVolume[2];        // the grid this frame's update writes
    vec4 giVolumeMod[2];
    vec4 giPrevVolume[2];    // the grid the atlas holds until then; w 0 if none
    vec4 giPrevVolumeMod[2];
    mat4 giRotation;         // this frame's random turn of the ray set
    vec4 giSky;              // rgb a ray that escapes upward; w hysteresis
    vec4 giGround;           // rgb one that escapes downward
    vec4 giRayLength;        // x, y per cascade; z the largest lift (rt_gi_exposure)
} pass;

// How many rays of a kind (pass.rays), 1 to RT_MAX_RAYS.
const uint RT_MAX_RAYS = 5u;
uint rtRayCount(float setting) {
    return clamp(uint(setting + 0.5), 1u, RT_MAX_RAYS);
}

const uint RT_MODE_SHADOWS = 1u;
const uint RT_MODE_AO = 2u;
const uint RT_MODE_GI = 3u;

// PCG hash. Good enough decorrelation per pixel and frame that the temporal
// filter sees independent samples.
uint rtHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

uint rtSeed(uvec2 pixel, uint frame) {
    return rtHash(pixel.x ^ rtHash(pixel.y ^ rtHash(frame)));
}

float rtRandom(inout uint state) {
    state = rtHash(state);
    return float(state) * (1.0 / 4294967296.0);
}

// An orthonormal basis around n (Duff et al. 2017).
void rtBasis(vec3 n, out vec3 t, out vec3 b) {
    float s = n.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (s + n.z);
    float c = n.x * n.y * a;
    t = vec3(1.0 + s * n.x * n.x * a, s * c, -s * n.x);
    b = vec3(c, s + n.y * n.y * a, -n.y);
}

vec3 rtCosineHemisphere(vec3 n, inout uint rng) {
    float u = rtRandom(rng), v = rtRandom(rng);
    float r = sqrt(u);
    float phi = 6.28318530718 * v;
    vec3 t, b;
    rtBasis(n, t, b);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u)));
}

// A direction inside the cone of half-angle atan(tanRadius) around d.
vec3 rtConeSample(vec3 d, float tanRadius, inout uint rng) {
    float u = rtRandom(rng), v = rtRandom(rng);
    float r = sqrt(u) * tanRadius;
    float phi = 6.28318530718 * v;
    vec3 t, b;
    rtBasis(d, t, b);
    return normalize(d + t * (r * cos(phi)) + b * (r * sin(phi)));
}

vec4 rtUnpackSurface(float packed) {
    return unpackUnorm4x8(floatBitsToUint(packed));
}

// World position of a pixel in the scene depth.
vec3 rtWorldFromDepth(vec2 uv, float depth) {
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 w = pass.invViewProj * ndc;
    return w.xyz / w.w;
}

// The same less the camera position, without passing through the world's
// coordinates: some ten thousand yards out, where a float steps a thousandth
// of a yard, as far as one pixel is from the next on a surface a yard from
// the eye. Differences between neighbours - a normal, a direction - are taken
// from this.
vec3 rtRelFromDepth(vec2 uv, float depth) {
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 w = pass.invViewProjRel * ndc;
    return w.xyz / w.w;
}

// The geometric normal at a pixel p (camera-relative, reversed depth d) from
// its neighbours, left and right, down and up - their depths and their
// positions: on each axis the one that continues the slope best. rt_prepare
// takes it for the texels and rt_apply for the pixels, alike, so the two
// compare like with like (rtNormalWeight).
//
// A neighbour that is the sky (depth 0) is no point to take a slope to: its
// position is at infinity. rt_prepare took it where it was the only one on
// an axis - a leaf a pixel across against the evening sky, a twig - or the
// nearer slope, and the normal came out NaN; rt_apply's weight of every
// texel there went NaN with it, and the canopy drew black pixels in columns
// where the leaves are narrow, that came and went as the leaves swayed and
// the camera moved. The other neighbour where one is the sky; with the sky
// on both sides, no slope, and the pixel faces the camera.
vec3 rtSlopeNormal(vec3 p, float d, float dl, vec3 pl, float dr, vec3 pr, float dd, vec3 pd, float du, vec3 pu) {
    bool skyL = dl <= 0.0, skyR = dr <= 0.0, skyD = dd <= 0.0, skyU = du <= 0.0;
    bool takeR = !skyR && (skyL || abs(dr - d) < abs(d - dl));
    bool takeU = !skyU && (skyD || abs(du - d) < abs(d - dd));
    vec3 dx = takeR ? pr - p : (skyL ? vec3(0.0) : p - pl);
    vec3 dy = takeU ? pu - p : (skyD ? vec3(0.0) : p - pd);
    vec3 n = cross(dx, dy);
    if (!(dot(n, n) > 1e-20) || any(isnan(n)) || any(isinf(n))) return -normalize(p);
    n = normalize(n);
    return dot(n, p) > 0.0 ? -n : n;
}

// The tracer's G-buffer texel, at trace resolution: octahedral normal in xy
// (rebuilt from the depth), distance to the camera in z (0 for sky), and in
// w which pixel of the 2x2 scene block it was taken from (0-3, x fastest),
// plus 4 where that pixel is a surface of the tracing's (RT_GB_VALID in the
// opaque G-buffer). The nearest such surface in the block is kept, or the
// farthest on every other texel (rtTakesFarthest), so along an edge both
// sides have texels of their own; a surface is always taken over the sky.
vec3 rtGbufNormal(vec4 g) { return rtOctDecode(g.xy); }
float rtGbufDist(vec4 g) { return g.z; }
int rtGbufSub(vec4 g) { return int(g.w + 0.5) & 3; }
bool rtGbufValid(vec4 g) { return (int(g.w + 0.5) & 4) != 0; }

// How many scene pixels a trace texel stands for along each axis: 2 at half
// resolution, 1 when every pixel is traced (RtLighting::setFullResolution).
int rtBlockSize() {
    return pass.extent.x * 1.5 > pass.sceneExtent.x ? 1 : 2;
}

// The first scene pixel of trace texel px's block.
ivec2 rtBlockBase(ivec2 px) {
    return ivec2(floor(vec2(px) * pass.sceneExtent.xy * pass.extent.zw));
}

// The scene pixel a G-buffer texel stands for.
ivec2 rtGbufPixel(vec4 g, ivec2 px) {
    int sub = rtGbufSub(g);
    return rtBlockBase(px) + ivec2(sub & 1, sub >> 1);
}

// World position a G-buffer texel stands for.
vec3 rtGbufWorld(vec4 g, ivec2 px) {
    vec2 uv = (vec2(rtGbufPixel(g, px)) + 0.5) * pass.sceneExtent.zw;
    vec3 dir = normalize(rtRelFromDepth(uv, 0.5));
    return pass.cameraPos.xyz + dir * g.z;
}

// Distance the ray has to leave a surface by before it may hit it again.
// Grows with distance from the camera, as the depth buffer's precision falls.
float rtSurfaceOffset(float viewDist) {
    return 0.02 + viewDist * 0.002;
}
