// Whether a triangle is there where a ray crosses it, for both
// tracers (rt_trace_hw.glsli, rt_trace_sw.glsli), which include this after
// declaring RtTri.
//
// A cutout - a leaf card, a fence, a banner - is tested against its texture's
// 64x64 visibility at the point hit (RtScene::addAlphaMask), as the shadow
// map's alpha test has it (shadow.frag): a tree's shadow then has the gaps
// between its leaves. Taking the texture's coverage as the chance of a hit
// instead gave the same canopy as a near-solid blob - four cards of half
// coverage stop all but a sixteenth of the rays - and laid the open road of
// Goldshire in shade. That is what is left for a translucent triangle with no
// mask.

// The scene's descriptor set: 1 in the lighting passes, another where the
// shader that traces has its own sets there (water.frag's 3).
#ifndef RT_SCENE_SET
#define RT_SCENE_SET 1
#endif

// Three UVs as half2; .w the mask in the low half and the detail texture
// (rt_trace_detail.glsli) in the high, 0xFFFF for none.
struct RtTriExtra { uvec4 data; };
layout(std430, set = RT_SCENE_SET, binding = 6) readonly buffer RtTriExtras { RtTriExtra rtTriExtras[]; };
layout(std430, set = RT_SCENE_SET, binding = 7) readonly buffer RtMasks { uint rtMasks[]; };
// A group's box, min and max (RtScene::setGroupBounds); group 0 is none.
layout(std430, set = RT_SCENE_SET, binding = 9) readonly buffer RtGroups { vec4 rtGroups[]; };

// Set by the caller for one ray: pass every grouped instance - every unit and
// what it carries - by. The sun's ray does near the camera, where the shadow
// map draws the units truly posed and this frame (rt_trace.comp).
bool rtSkipUnits = false;
// Set by the caller for one ray: how far along it a grouped instance - a
// unit, what it carries - may stop it; past that the units are passed by.
// The point lights' shadow rays (rt_trace.comp) keep a unit's shadow to the
// stretch of floor or wall near it.
float rtUnitReach = 1e30;
// Set by the caller for one point light's ray: where its light is. A unit
// whose box holds it carries the light - a mount's burning mane and hooves,
// a staff's glow - and does not shadow it: its rigid traced pieces round the
// light cut wedges out of the ground it lights (the Dreadsteed in Thunder
// Bluff).
vec3 rtLampEnd = vec3(1e30);
// How far outside its box a unit still counts as carrying a light: the box
// stands a little off the floor, and a glow's light is taken from above its
// centre (rtLightAim).
const float RT_CARRIED_LIGHT_SLACK = 1.0;
// Set by rtOccludedByStructure for one ray in the software tracer: only the
// ground and the buildings stop it (the hardware tracer's ray mask).
bool rtStructureOnly = false;
// Set by the caller for one fixed light's ray: fixtures do not stop it
// (RtScene::kMeshFixture, kRayNoFixtures).
bool rtSkipFixtures = false;
// Set with it when point lights shadow themselves (the Ray Tracing page's
// "Self-shadowing for point lights", a WoWee-only option): the fixtures
// still stop the ray, but only by their faces turned toward the light -
// whose winding normal points along the ray, which runs from the surface to
// the light - so a light inside a lantern shines out through its outer
// faces and its bars and frame still cast shadows.
bool rtFixtureFacesOnly = false;
// Set by the caller for one ray: a cutout or a translucent triangle - a leaf
// card, a fence, a banner - lets it through. The occlusion's rays
// (rt_trace.comp): a canopy is cards standing in for a loose volume of
// leaves, and their 64x64 masks stack four or five deep - every ray from a
// leaf met another a few hand-widths off, the leaves' light, most of it the
// sky's in the evening shade, was taken to half and then under the sun's
// shade to nearly nothing: black speckles over the trees, and with the one
// ray a pixel they flickered as the camera moved. The sky's light comes
// through leaves; their shadow of the sun is the sun ray's, which they still
// stop.
bool rtCutoutsOpen = false;
// Left by rtClosestEx: the triangle (in rtTris) and the instance it hit
// last, for rt_trace_detail.glsli.
uint rtHitTri = 0u;
uint rtHitInstance = 0u;

// A ray that looks at a unit instead of shadowing from one: it starts inside
// the unit's box because the box crosses what it left from, not because the
// unit is its own (the water's surface, through a wader's waist).
bool rtMeetsOwnGroup = false;

// Whether a ray from p passes the instances of `group` by: it starts inside
// the group's box - on the character the group is, which never shadows or
// occludes itself.
bool rtInGroup(uint group, vec3 p) {
    if (group == 0u) return false;
    if (rtSkipUnits) return true;
    if (rtMeetsOwnGroup) return false;
    vec3 lo = rtGroups[group * 2u].xyz;
    vec3 hi = rtGroups[group * 2u + 1u].xyz;
    if (all(greaterThanEqual(p, lo)) && all(lessThanEqual(p, hi))) return true;
    // Nor the light it carries (rtLampEnd).
    return all(greaterThanEqual(rtLampEnd, lo - RT_CARRIED_LIGHT_SLACK)) &&
           all(lessThanEqual(rtLampEnd, hi + RT_CARRIED_LIGHT_SLACK));
}

// bary: the hit's weights of v1 and v2.
bool rtSolidAt(RtTri tri, vec2 bary, inout uint rng) {
    float opacity = rtUnpackSurface(tri.v0.w).a;
    if (opacity >= 1.0) return true;
    if (rtCutoutsOpen) return false;
    uint extra = floatBitsToUint(tri.v2.w);
    if (extra != 0u) {
        uvec4 e = rtTriExtras[extra - 1u].data;
        uint mask = e.w & 0xFFFFu;
        if (mask == 0xFFFFu) return rtRandom(rng) < opacity;
        vec2 uv = unpackHalf2x16(e.x) * (1.0 - bary.x - bary.y) + unpackHalf2x16(e.y) * bary.x +
                  unpackHalf2x16(e.z) * bary.y;
        ivec2 t = ivec2(fract(uv) * 64.0) & 63;
        uint word = rtMasks[mask * 128u + uint(t.y) * 2u + uint(t.x >> 5)];
        return ((word >> uint(t.x & 31)) & 1u) != 0u;
    }
    return rtRandom(rng) < opacity;
}
