// The ray traced lighting's apply pass (docs/deferred_rt_design.md), included
// by rt_apply.frag.glsl and, with RT_MSAA, by rt_apply_ms.frag.glsl, which
// runs once per sample.
//
// The opaque surfaces drew their colour C0 with the traced terms neutral and
// wrote beside it how that colour depends on them (rt_gbuffer.glsli). This
// finds the traced terms of the pixel's own surface in the traced result
// (half resolution, or full: RtLighting::setFullResolution) and turns them
// into a factor and an addend, which the blend applies to the colour already
// there: dst * outMul + outAdd (dual-source blending),
// so the colour is never copied. Mirrored for the unit tests by
// rt_gbuffer_pack.hpp's apply().
//
// The surface is found among the 3x3 traced texels around it (joint
// bilateral, rt_upsample.glsli): by its distance from the camera or the
// texel's plane, weighed by the normal and by how far the pixel each texel
// was traced from lies from this one; where none of them is its own, one
// ring farther. rt_lighting.glsli's rtLightAt finds a blended one's the same
// way by distance alone. Where none is its own - a thin pole the half
// resolution missed - it is lit as without the tracing, as a surface with no
// result always was.

#include "rt_common.glsli"

#ifdef RT_MSAA
layout(set = 0, binding = 1) uniform sampler2DMS uSceneDepth;
layout(set = 0, binding = 13) uniform sampler2DMS uSceneGbuf0;
layout(set = 0, binding = 14) uniform sampler2DMS uSceneGbuf1;
#else
layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 13) uniform sampler2D uSceneGbuf0;
layout(set = 0, binding = 14) uniform sampler2D uSceneGbuf1;
#endif
// The tracer's G-buffer: the normal each texel was traced with, and from
// which pixel (rt_prepare).
layout(set = 0, binding = 3) uniform sampler2D uTraceGbuf;
// The filtered result: sun, occlusion, point lights' visibility, distance.
layout(set = 0, binding = 9) uniform sampler2D uLight;
// The point lights unshadowed; a = the baked lights' part.
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D uPoint;
// The history, whose alpha is its length (debug view 8).
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D uHist;

layout(location = 0, index = 0) out vec4 outAdd;
layout(location = 0, index = 1) out vec4 outMul;

// The traced terms of the pixel's surface, as rt_lighting.glsli's RtLight.
struct Traced {
    float weight;
    float sun;
    float ao;
    vec3 point;
    vec3 pointOwn;
    float bakedShade;
    float interiorShade;  // rtInteriorShade
    float best;     // how well the best texel matched (debug view 9)
};

// The running sums of the texels found so far.
struct Found {
    float wsum;
    float best;
    vec2 sunAo;
    vec4 point;
    float bakedDark;
};

// One traced texel q into the sums, by how well it is the surface of the
// pixel at scene position pixf (pixel units), whose point relative to the
// camera is rel, at distance expected, with geometric normal np.
void gatherTexel(ivec2 q, vec2 pixf, vec3 rel, vec3 np, float expected, inout Found acc) {
    vec4 l = texelFetch(uLight, q, 0);
    if (l.a <= 0.0) return;
    vec4 tg = texelFetch(uTraceGbuf, q, 0);
    vec2 tp = vec2(rtGbufPixel(tg, q)) + 0.5;  // the scene pixel it was traced from
    vec3 trel = rtViewDir(tp * pass.sceneExtent.zw) * l.a;
    vec3 tn = rtGbufNormal(tg);
    float match = max(rtDistanceMatch(l.a, expected), rtPlaneMatch(rel, trel, tn, expected, l.a));
    vec2 o = (tp - pixf) / float(rtBlockSize());
    float w = match * exp(-dot(o, o)) * rtNormalWeight(np, tn);
    if (w <= 1e-5) return;
    acc.best = max(acc.best, match);
    acc.wsum += w;
    vec4 p = imageLoad(uPoint, q);
    // l.b below 0: a light the ground or a building stopped (rtGather).
    acc.point += p * (max(mix(1.0, l.b, pass.tune2.y), 0.0) * w);
    acc.bakedDark += rtBakedDarkness(p.a, clamp(l.b, 0.0, 1.0)) * w;
    acc.sunAo += l.rg * w;
}

Traced findTraced(vec2 pixf, vec3 rel, vec3 np, float expected) {
    Traced r = Traced(0.0, 1.0, 1.0, vec3(0.0), vec3(0.0), 1.0, 1.0, 0.0);
    ivec2 size = ivec2(pass.extent.xy);
    vec2 f = pixf / float(rtBlockSize()) - 0.5;
    ivec2 center = ivec2(floor(f + 0.5));
    Found acc = Found(0.0, 0.0, vec2(0.0), vec4(0.0), 0.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = center + ivec2(x, y);
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
            gatherTexel(q, pixf, rel, np, expected, acc);
        }
    }
    // Nothing of its own close by - one side of an edge whose texels the
    // other side took, a grazing floor: the ring beyond, whose texels count
    // for little beside any nearer one.
    if (acc.best < 0.6) {
        for (int y = -2; y <= 2; ++y) {
            for (int x = -2; x <= 2; ++x) {
                if (abs(x) < 2 && abs(y) < 2) continue;
                ivec2 q = center + ivec2(x, y);
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
                gatherTexel(q, pixf, rel, np, expected, acc);
            }
        }
    }
    float wsum = acc.wsum;
    r.best = acc.best;
    if (wsum <= 1e-5) return r;
    r.weight = smoothstep(0.1, 0.6, acc.best);
    r.sun = acc.sunAo.x / wsum;
    r.ao = acc.sunAo.y / wsum;
    r.point = acc.point.rgb / wsum * (r.weight * pass.tune.w);
    // The other lights' part: the whole less the baked lights' share of it.
    float total = max(acc.point.r, max(acc.point.g, acc.point.b));
    r.pointOwn = r.point * (total > 1e-4 ? clamp(1.0 - acc.point.a / total, 0.0, 1.0) : 1.0);
    r.bakedShade = 1.0 - pass.tune2.x * r.weight * acc.bakedDark / wsum;
    r.interiorShade = rtInteriorShade(acc.point.rgb / wsum, r.weight, pass.tune3.x, pass.tune3.y);
    return r;
}

// The pixel's geometric normal, rebuilt from the depth as rt_prepare
// rebuilds the texels' (on each axis the neighbour that continues the slope),
// so the two compare like with like.
float depthAt(ivec2 p, int s) {
    p = clamp(p, ivec2(0), ivec2(pass.sceneExtent.xy) - 1);
    return texelFetch(uSceneDepth, p, s).r;
}

vec3 relAt(ivec2 p, float depth) {
    return rtRelFromDepth((vec2(p) + 0.5) * pass.sceneExtent.zw, depth);
}

vec3 geometricNormal(ivec2 pix, int s, float d, vec3 p) {
    float dl = depthAt(pix + ivec2(-1, 0), s), dr = depthAt(pix + ivec2(1, 0), s);
    float dd = depthAt(pix + ivec2(0, -1), s), du = depthAt(pix + ivec2(0, 1), s);
    return rtSlopeNormal(p, d, dl, relAt(pix + ivec2(-1, 0), dl), dr, relAt(pix + ivec2(1, 0), dr),
                         dd, relAt(pix + ivec2(0, -1), dd), du, relAt(pix + ivec2(0, 1), du));
}

// rtEdgeOnLift (rt_lighting.glsli).
float edgeOnLift(vec3 n, vec3 toLight) {
    return clamp(pow(abs(1.2 - abs(dot(n, toLight))), 4.0), 0.0, 1.0);
}

void main() {
    ivec2 pix = ivec2(gl_FragCoord.xy);
#ifdef RT_MSAA
    int s = gl_SampleID;
#else
    int s = 0;
#endif
    outAdd = vec4(0.0);
    outMul = vec4(1.0);
    float depth = texelFetch(uSceneDepth, pix, s).r;
    vec4 gb0 = texelFetch(uSceneGbuf0, pix, s);
    if ((rtGbufFlags(gb0) & RT_GB_VALID) == 0u || depth <= 0.0) return;  // reversed depth: 0 is the sky
    RtGbuf g = rtGbufUnpack(gb0, texelFetch(uSceneGbuf1, pix, s));

    vec2 uv = (vec2(pix) + 0.5) * pass.sceneExtent.zw;
    vec3 rel = rtRelFromDepth(uv, depth);
    float expected = length(rel);
    Traced r = findTraced(vec2(pix) + 0.5, rel, geometricNormal(pix, s, depth, rel), expected);

    // The sun's shadow scale over the one C0 was drawn with: the shadow
    // variants' (1 - k) + k x the light let through, the lesser of the map's
    // and the traced shadow (rtShadow, rtShadowScale); without a result of its
    // own, 0.7 + 0.3 x the map's as without the tracing.
    float rs = 1.0;
    if ((g.flags & RT_GB_SUN) != 0u) {
        float k = pass.tune.x;
        float lift = (g.flags & RT_GB_LIFT_AFTER) != 0u ? edgeOnLift(g.normal, normalize(pass.sunDir.xyz)) : 0.0;
        float lit0 = g.map + (1.0 - g.map) * lift;
        float m = min(g.map, 1.0 - r.weight * pass.tune.y * (1.0 - r.sun));
        float lit = m + (1.0 - m) * lift;
        float sigma0 = (1.0 - k) + k * lit0;
        float sigma = mix(0.7 + 0.3 * lit, (1.0 - k) + k * lit, r.weight);
        rs = sigma / max(sigma0, 1e-4);
    }
    bool baked = (g.flags & RT_GB_BAKED) != 0u;
    // Inside, the room's own light over its baked colour or the baked lamps'
    // shadows, whichever is darker: the lesser, so the one does not darken
    // twice what the other has already (rtInteriorShade).
    float shade = (g.flags & RT_GB_INTERIOR) != 0u ? min(r.bakedShade, r.interiorShade) : r.bakedShade;
    // A unit on an interior floor is lit by that floor's colour (0x007a0d60),
    // which holds the room's lamps as they reach the floor already. Shaded
    // again at its own pixels, an upright body took the shadow of every
    // building light in front of its face that the floor turns away - the
    // hearth's a yard under the Goldshire inn's upper floor above all - and
    // the trainers there drew at half their colour or less. As painted, as a
    // see-through unit already is (rtLightBehind); the other lights still add.
    if ((g.flags & RT_GB_UNIT_FLOOR) != 0u) shade = 1.0;
    float rIn = baked ? shade : 1.0;
    // The light added, held to the most the settings allow (rtCapLight). Not
    // the baked or sunlit colour under it: this pass has the factor it is
    // scaled by, not the colour, so the light already in it is unknown here.
    r.point = rtCapLight(r.point, pass.tune3.z);
    r.pointOwn = rtCapLight(r.pointOwn, pass.tune3.z);
    vec3 pointIn = baked ? r.pointOwn : r.point;
    // The occlusion over the flat ambient (rtAmbient), from Shadows and
    // occlusion on.
    float ao = pass.params.x >= float(RT_MODE_AO) - 0.5 ? 1.0 - r.weight * pass.tune.z * (1.0 - r.ao) : 1.0;
    if ((g.flags & RT_GB_TRANSITION) != 0u) {
        // A transition batch's two passes (rtSurfaceMix): the sun's shade
        // over the outside pass's share, the baked shade over the inside's;
        // all the lights on the outside pass, the others on a baked inside.
        float f = g.outside;
        float rr = mix(rIn, rs, f);
        outMul = vec4(vec3(1.0) + g.g * (f * (rs - 1.0) + (1.0 - f) * (rIn - 1.0)) -
                      rr * rtOcclusionLoss(g, ao), 1.0);
        outAdd = vec4(g.kp * mix(pointIn, r.point, f), 0.0);
    } else {
        float rr = rs * rIn;
        outMul = vec4(vec3(1.0) + g.g * (rr - 1.0) - rr * rtOcclusionLoss(g, ao), 1.0);
        outAdd = vec4(g.kp * pointIn, 0.0);
    }

    // WOWEE_GI_DEBUG 5-9 and the Debug Graphics views, instead of the picture:
    // the traced sun's visibility, the point lights' light as it is added,
    // the traced occlusion (red: no result of its own), how long the history
    // runs here (green a full one, red one just begun), and how well the
    // pixel found its own surface in the half resolution (green fully, red
    // not at all); 10 a baked colour's two shades: red the building's lamps'
    // shadows leave (rtBakedShade), green and blue the room's light
    // (rtInteriorShade) - white as painted, cyan darkened by the lamps'
    // shadows, red by the room's light, grey by both; dark blue no baked
    // colour.
    int view = int(pass.tune2.z + 0.5);
    if (view == 11) {
        // Where the scene's depth breaks within a pixel: magenta at a
        // geometric edge (a neighbour another surface, more than 5% nearer
        // or farther, or the sky), green elsewhere. The mask the flicker
        // measurement looks at (tools/rt_flicker.py); no lighting.
        bool edge = false;
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec2 q = clamp(pix + ivec2(x, y), ivec2(0), ivec2(pass.sceneExtent.xy) - 1);
                float dq = texelFetch(uSceneDepth, q, s).r;
                float e = dq > 0.0 ? length(rtRelFromDepth((vec2(q) + 0.5) * pass.sceneExtent.zw, dq)) : 1e9;
                edge = edge || abs(e - expected) > 0.05 * expected;
            }
        }
        outMul = vec4(0.0);
        outAdd = vec4(edge ? vec3(1.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0), 0.0);
        return;
    }
    // 12 the point lights' light this pixel adds (before the texel), 13 the
    // factor its baked colour is scaled by - the lamps' shadows and the
    // room's shade together, grey, white as painted - red where it is no
    // baked colour.
    // 14 the kind of each light (rt_light_kinds.hpp): every light's light,
    // a building's too, each tinted by the trace in its kind's colour.
    if (view == 12 || view == 13 || view == 14) {
        vec3 c = view == 12 ? pointIn : view == 14 ? r.point : (baked ? vec3(rIn) : vec3(1.0, 0.0, 0.0));
        outMul = vec4(0.0);
        outAdd = vec4(c, 0.0);
        return;
    }
    if (view >= 5 && view <= 10) {
        vec3 c = vec3(0.0);
        if (view == 5) c = r.weight > 0.0 ? vec3(r.sun) : vec3(1.0, 0.0, 0.0);
        else if (view == 6) c = r.point;
        else if (view == 7) c = r.weight > 0.0 ? vec3(r.ao) : vec3(1.0, 0.0, 0.0);
        else if (view == 8) {
            ivec2 q = clamp(ivec2(uv * pass.extent.xy), ivec2(0), ivec2(pass.extent.xy) - 1);
            float len = clamp(imageLoad(uHist, q).a / 24.0, 0.0, 1.0);
            c = vec3(1.0 - len, len, 0.0);
        } else if (view == 9) {
            c = vec3(1.0 - r.best, r.best, 0.0);
        } else {
            bool asPainted = (g.flags & RT_GB_UNIT_FLOOR) != 0u;
            float room = (g.flags & RT_GB_INTERIOR) != 0u ? r.interiorShade : 1.0;
            c = !baked ? vec3(0.1, 0.15, 0.45) : asPainted ? vec3(1.0) : vec3(r.bakedShade, room, room);
        }
        outMul = vec4(0.0);
        outAdd = vec4(c, 0.0);
    }
}
