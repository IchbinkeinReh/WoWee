// The ray traced lighting's apply pass (docs/deferred_rt_design.md), included
// by rt_apply.frag.glsl and, with RT_MSAA, by rt_apply_ms.frag.glsl, which
// runs once per sample.
//
// The opaque surfaces drew their colour C0 with the traced terms neutral and
// wrote beside it how that colour depends on them (rt_gbuffer.glsli). This
// finds the traced terms of the pixel's own surface in the half-resolution
// result and turns them into a factor and an addend, which the blend applies
// to the colour already there: dst * outMul + outAdd (dual-source blending),
// so the colour is never copied. Mirrored for the unit tests by
// rt_gbuffer_pack.hpp's apply().
//
// The surface is found by its distance from the camera among the 3x3 traced
// texels around it, as rt_lighting.glsli's rtLightAt finds a blended one's.
// Where none is its own - a thin pole the half resolution missed - it is lit
// as without the tracing, as a surface with no result always was.

#include "rt_common.glsli"

#ifdef RT_MSAA
layout(set = 0, binding = 1) uniform sampler2DMS uSceneDepth;
layout(set = 0, binding = 13) uniform sampler2DMS uSceneGbuf0;
layout(set = 0, binding = 14) uniform sampler2DMS uSceneGbuf1;
#else
layout(set = 0, binding = 1) uniform sampler2D uSceneDepth;
layout(set = 0, binding = 13) uniform sampler2D uSceneGbuf0;
layout(set = 0, binding = 14) uniform sampler2D uSceneGbuf1;
#endif
// The filtered result: sun, occlusion, point lights' visibility, distance.
layout(set = 0, binding = 9) uniform sampler2D uLight;
// The point lights unshadowed; a = the baked lights' part.
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D uPoint;
// The history, whose alpha is its length (debug view 8).
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D uHist;

layout(location = 0, index = 0) out vec4 outAdd;
layout(location = 0, index = 1) out vec4 outMul;

// The traced terms of the pixel's surface, as rt_lighting.glsli's RtLight.
struct Traced {
    float weight;
    float sun;
    float ao;
    vec3 point;
    vec3 pointOwn;
    float bakedShade;
    float best;     // how well the best texel matched (debug view 9)
};

Traced findTraced(vec2 uv, float expected) {
    Traced r = Traced(0.0, 1.0, 1.0, vec3(0.0), vec3(0.0), 1.0, 0.0);
    ivec2 size = ivec2(pass.extent.xy);
    vec2 f = uv * pass.extent.xy - 0.5;
    ivec2 center = ivec2(floor(f + 0.5));
    float tolerance = 0.03 * expected + 0.05;
    float pointShadow = pass.tune2.y;
    float wsum = 0.0;
    float best = 0.0;
    vec2 sunAo = vec2(0.0);
    vec4 point = vec4(0.0);
    float bakedDark = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = clamp(center + ivec2(x, y), ivec2(0), size - 1);
            vec4 l = texelFetch(uLight, q, 0);
            float e = (l.a - expected) / tolerance;
            float match = l.a > 0.0 ? exp(-e * e) : 0.0;
            vec2 o = vec2(q) - f;
            float w = match * exp(-dot(o, o));
            if (w <= 1e-4) continue;
            best = max(best, match);
            wsum += w;
            vec4 p = imageLoad(uPoint, q);
            point += p * (mix(1.0, l.b, pointShadow) * w);
            bakedDark += min(p.a, 1.0) * (1.0 - l.b) * w;
            sunAo += l.rg * w;
        }
    }
    r.best = best;
    if (wsum <= 1e-4) return r;
    r.weight = smoothstep(0.1, 0.6, best);
    r.sun = sunAo.x / wsum;
    r.ao = sunAo.y / wsum;
    r.point = point.rgb / wsum * (r.weight * pass.tune.w);
    // The other lights' part: the whole less the baked lights' share of it.
    float total = max(point.r, max(point.g, point.b));
    r.pointOwn = r.point * (total > 1e-4 ? clamp(1.0 - point.a / total, 0.0, 1.0) : 1.0);
    r.bakedShade = 1.0 - pass.tune2.x * r.weight * bakedDark / wsum;
    return r;
}

// rtEdgeOnLift (rt_lighting.glsli).
float edgeOnLift(vec3 n, vec3 toLight) {
    return clamp(pow(abs(1.2 - abs(dot(n, toLight))), 4.0), 0.0, 1.0);
}

void main() {
    ivec2 pix = ivec2(gl_FragCoord.xy);
#ifdef RT_MSAA
    int s = gl_SampleID;
#else
    int s = 0;
#endif
    outAdd = vec4(0.0);
    outMul = vec4(1.0);
    float depth = texelFetch(uSceneDepth, pix, s).r;
    vec4 gb0 = texelFetch(uSceneGbuf0, pix, s);
    if ((rtGbufFlags(gb0) & RT_GB_VALID) == 0u || depth >= 1.0) return;
    RtGbuf g = rtGbufUnpack(gb0, texelFetch(uSceneGbuf1, pix, s));

    vec2 uv = (vec2(pix) + 0.5) * pass.sceneExtent.zw;
    float expected = length(rtRelFromDepth(uv, depth));
    Traced r = findTraced(uv, expected);

    // The sun's shadow scale over the one C0 was drawn with: the shadow
    // variants' (1 - k) + k x the light let through, the lesser of the map's
    // and the traced shadow (rtShadow, rtShadowScale); without a result of its
    // own, 0.7 + 0.3 x the map's as without the tracing.
    float rs = 1.0;
    if ((g.flags & RT_GB_SUN) != 0u) {
        float k = pass.tune.x;
        float lift = (g.flags & RT_GB_LIFT_AFTER) != 0u ? edgeOnLift(g.normal, normalize(pass.sunDir.xyz)) : 0.0;
        float lit0 = g.map + (1.0 - g.map) * lift;
        float m = min(g.map, 1.0 - r.weight * pass.tune.y * (1.0 - r.sun));
        float lit = m + (1.0 - m) * lift;
        float sigma0 = (1.0 - k) + k * lit0;
        float sigma = mix(0.7 + 0.3 * lit, (1.0 - k) + k * lit, r.weight);
        rs = sigma / max(sigma0, 1e-4);
    }
    bool baked = (g.flags & RT_GB_BAKED) != 0u;
    float rr = rs * (baked ? r.bakedShade : 1.0);
    // The occlusion over the flat ambient (rtAmbient), from Shadows and
    // occlusion on.
    float ao = pass.params.x >= float(RT_MODE_AO) - 0.5 ? 1.0 - r.weight * pass.tune.z * (1.0 - r.ao) : 1.0;
    outMul = vec4(vec3(1.0) + g.g * (rr - 1.0) - rr * rtOcclusionLoss(g, ao), 1.0);
    outAdd = vec4(g.kp * (baked ? r.pointOwn : r.point), 0.0);

    // WOWEE_GI_DEBUG 5-9 and the Debug Graphics views, instead of the picture:
    // the traced sun's visibility, the point lights' light as it is added,
    // the traced occlusion (red: no result of its own), how long the history
    // runs here (green a full one, red one just begun), and how well the
    // pixel found its own surface in the half resolution (green fully, red
    // not at all).
    int view = int(pass.tune2.z + 0.5);
    if (view >= 5 && view <= 9) {
        vec3 c = vec3(0.0);
        if (view == 5) c = r.weight > 0.0 ? vec3(r.sun) : vec3(1.0, 0.0, 0.0);
        else if (view == 6) c = r.point;
        else if (view == 7) c = r.weight > 0.0 ? vec3(r.ao) : vec3(1.0, 0.0, 0.0);
        else if (view == 8) {
            ivec2 q = clamp(ivec2(uv * pass.extent.xy), ivec2(0), ivec2(pass.extent.xy) - 1);
            float len = clamp(imageLoad(uHist, q).a / 24.0, 0.0, 1.0);
            c = vec3(1.0 - len, len, 0.0);
        } else {
            c = vec3(1.0 - r.best, r.best, 0.0);
        }
        outMul = vec4(0.0);
        outAdd = vec4(c, 0.0);
    }
}
