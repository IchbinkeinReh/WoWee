// Texture magnification beyond the client's bilinear filter.
//
// Up close a texture is magnified: one texel spreads over many pixels, and
// bilinear filtering joins neighbouring texels with straight ramps, so the
// texel grid and the stair steps along colour edges stay visible. A cubic
// filter joins them with smooth curves instead. It only takes over while the
// texture is actually magnified; minified (from a distance) every texture is
// sampled exactly as before, mipmaps and all.
//
// The mode comes from the per-frame data, in viewPos.w (otherwise unused):
// 1 bilinear as the client draws, 2 a cubic B-spline (soft, no ringing),
// 3 Catmull-Rom (sharper, can leave a faint halo on hard edges). Anything
// below 1 - the character preview writes 0 - is bilinear.

int textureFilterMode(float viewPosW) {
    return max(int(viewPosW + 0.5) - 1, 0);
}

// How far the cubic filter is blended in: 1 while one texel covers more than
// a pixel and a half, 0 once texels are pixel-sized, so the switch from the
// mipmapped sample never shows as a line.
float magnificationWeight(vec2 texSize, vec2 dx, vec2 dy) {
    const float texelsPerPixel = max(length(dx * texSize), length(dy * texSize));
    return 1.0 - smoothstep(0.66, 1.0, texelsPerPixel);
}

// Cubic B-spline in four bilinear taps (Sigg and Hadwiger, GPU Gems 2 ch. 20).
vec4 textureBSpline(sampler2D tex, vec2 uv, vec2 texSize) {
    const vec2 invSize = 1.0 / texSize;
    const vec2 p = uv * texSize - 0.5;
    const vec2 f = fract(p);
    const vec2 i = p - f;
    const vec2 f2 = f * f;
    const vec2 f3 = f2 * f;
    const vec2 w0 = (1.0 / 6.0) * (-f3 + 3.0 * f2 - 3.0 * f + 1.0);
    const vec2 w1 = (1.0 / 6.0) * (3.0 * f3 - 6.0 * f2 + 4.0);
    const vec2 w2 = (1.0 / 6.0) * (-3.0 * f3 + 3.0 * f2 + 3.0 * f + 1.0);
    const vec2 w3 = (1.0 / 6.0) * f3;
    const vec2 g0 = w0 + w1;
    const vec2 g1 = w2 + w3;
    const vec2 h0 = (i - 0.5 + w1 / g0) * invSize;
    const vec2 h1 = (i + 1.5 + w3 / g1) * invSize;
    const vec4 t00 = textureLod(tex, vec2(h0.x, h0.y), 0.0);
    const vec4 t10 = textureLod(tex, vec2(h1.x, h0.y), 0.0);
    const vec4 t01 = textureLod(tex, vec2(h0.x, h1.y), 0.0);
    const vec4 t11 = textureLod(tex, vec2(h1.x, h1.y), 0.0);
    return g0.y * (g0.x * t00 + g1.x * t10) + g1.y * (g0.x * t01 + g1.x * t11);
}

// Catmull-Rom in nine bilinear taps (the outer pairs of weights share a tap).
vec4 textureCatmullRom(sampler2D tex, vec2 uv, vec2 texSize) {
    const vec2 invSize = 1.0 / texSize;
    const vec2 samplePos = uv * texSize;
    const vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
    const vec2 f = samplePos - texPos1;
    const vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    const vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    const vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    const vec2 w3 = f * f * (-0.5 + 0.5 * f);
    const vec2 w12 = w1 + w2;
    const vec2 offset12 = w2 / w12;
    const vec2 tc0 = (texPos1 - 1.0) * invSize;
    const vec2 tc3 = (texPos1 + 2.0) * invSize;
    const vec2 tc12 = (texPos1 + offset12) * invSize;
    vec4 r = vec4(0.0);
    r += textureLod(tex, vec2(tc0.x,  tc0.y),  0.0) * w0.x  * w0.y;
    r += textureLod(tex, vec2(tc12.x, tc0.y),  0.0) * w12.x * w0.y;
    r += textureLod(tex, vec2(tc3.x,  tc0.y),  0.0) * w3.x  * w0.y;
    r += textureLod(tex, vec2(tc0.x,  tc12.y), 0.0) * w0.x  * w12.y;
    r += textureLod(tex, vec2(tc12.x, tc12.y), 0.0) * w12.x * w12.y;
    r += textureLod(tex, vec2(tc3.x,  tc12.y), 0.0) * w3.x  * w12.y;
    r += textureLod(tex, vec2(tc0.x,  tc3.y),  0.0) * w0.x  * w3.y;
    r += textureLod(tex, vec2(tc12.x, tc3.y),  0.0) * w12.x * w3.y;
    r += textureLod(tex, vec2(tc3.x,  tc3.y),  0.0) * w3.x  * w3.y;
    // The negative lobes can overshoot; a colour stays a colour.
    return clamp(r, 0.0, 1.0);
}

// textureGrad, with the cubic filter blended in where the texture is
// magnified. dx and dy are the uv's screen derivatives.
vec4 textureFilteredGrad(sampler2D tex, vec2 uv, vec2 dx, vec2 dy, int mode) {
    const vec4 base = textureGrad(tex, uv, dx, dy);
    if (mode <= 0) return base;
    const vec2 texSize = vec2(textureSize(tex, 0));
    const float w = magnificationWeight(texSize, dx, dy);
    if (w <= 0.0) return base;
    const vec4 cubic = mode == 1 ? textureBSpline(tex, uv, texSize)
                                 : textureCatmullRom(tex, uv, texSize);
    return mix(base, cubic, w);
}

vec4 textureFiltered(sampler2D tex, vec2 uv, int mode) {
    return textureFilteredGrad(tex, uv, dFdx(uv), dFdy(uv), mode);
}
