// The water's Gerstner waves (water.vert, or water.tese on tessellated water,
// displaces the surface by them; water.frag takes its normal from them at
// every pixel).
//
// What water.vert moves the grid by is worked out again on the CPU, for the
// swimmers, boats and camera that ride the waves (include/rendering/
// wave_surface.hpp: gerstner, physical, physicalShore, gerstnerShore, and
// paramsFor for the push constants). Change a wave here, change it there.
#ifndef WATER_WAVES_GLSLI
#define WATER_WAVES_GLSLI

// The shortest wave the liquid grid's vertices move as height, yards: shorter
// than the grid (a vertex every 4 yards) can carry. water.vert's cut-off, and
// wave_surface.hpp's kVertexMinWavelength.
#define PW_VERTEX_MIN_WAVELENGTH 9.0

// --- Gerstner wave ---
// Coordinate system: X,Y = horizontal plane, Z = up (height)
// displacement.xy = horizontal, displacement.z = vertical
struct GerstnerResult {
    vec3 displacement;
    vec3 tangent;   // along X
    vec3 binormal;  // along Y
    float waveHeight; // raw wave height for foam
    // The shore waves (evaluatePhysicalWavesShore, evaluateGerstnerWavesShore;
    // 0 from the others): the breaker index (the waves' significant height
    // over McCowan's limit for the depth, before they are held to it: 1 and
    // over, breaking), the shore part's phase of the wave carrying most of it
    // (its crest where the sine is 1), the share of the waves' height running
    // shoreward, and the open sea's significant height there, yards.
    float breaking;
    float shorePhase;
    float shoreWeight;
    float seaHeight;
    // The mean square slope (both ways) of the waves left out of the normal
    // (pwSlopeKeep): too short for the pixel, or for the calm. They are still
    // there, under the pixel, and roughen what it mirrors - water.frag widens
    // the glint by it rather than drawing a mirror too smooth for its waves.
    float hiddenSlope2;
};

// Nothing moved: the flat surface.
GerstnerResult flatWaves() {
    GerstnerResult r;
    r.displacement = vec3(0.0);
    r.tangent = vec3(1.0, 0.0, 0.0);
    r.binormal = vec3(0.0, 1.0, 0.0);
    r.waveHeight = 0.0;
    r.breaking = 0.0;
    r.shorePhase = 0.0;
    r.shoreWeight = 0.0;
    r.seaHeight = 0.0;
    r.hiddenSlope2 = 0.0;
    return r;
}

// --- Physically based waves (wave_spectrum.hpp is the C++ twin) ---
// A JONSWAP wind-sea spectrum sampled into 12 Gerstner waves, each at the
// speed deep-water dispersion gives its length (omega^2 = g k). Yards and
// seconds; the wind in metres per second. `minWavelength`: waves shorter than
// this are left out of the displacement (the vertex grid cannot carry them)
// and kept in the normal (the fragment stage passes 0). `fullWavelength`,
// when longer than that, fades the waves in between the two rather than
// cutting them off: the tessellated water (water.tese) moves its cut-off
// with the distance from the camera, and a wave switched on at a fixed
// distance would leave a step in the surface there.
const float PW_G = 9.80665 * 1.0936133;
const int PW_COUNT = 12;
// Two rungs' waves at most (pwWindBlend).
const int PW_MAX = 2 * PW_COUNT;

// The physics waves between two rungs of the ladder of winds
// (wave_spectrum::windRungs, sampleBlend): x the upper rung's share, y its
// wind in m/s (0 on a rung), z the lower rung's place on the ladder, whose
// waves' phases each rung's are. Each stage sets it from push.windBlend before it
// evaluates the waves. The two rungs' waves are each whole, only their
// heights shared: a spectrum resampled for an easing wind raced its crests.
vec3 pwWindBlend = vec3(0.0);

// The spectrum sampled: each wave's amplitude (yd), deep-water wavenumber
// (rad/yd) and angular frequency (rad/s), and the steepness Q they share so
// that sum(Q k a) is 0.75 at most.
// With the frame's block (water_frame.glsli: water.frag, water.tese) the
// spectrum is the frame's own sampling, `slot` of pwSpecKey, read from the
// block wave by wave where it is needed (pwWaveAt) - never copied into
// arrays, nor sampled here: three arrays of 24 a pixel, even only in a
// fallback that never ran, cost the water pass more than a millisecond
// (the stage's registers are its worst path's). Without it (water.vert),
// sampled here into the arrays.
struct PWSpectrum {
#ifndef WATER_FRAME_GLSLI
    float amps[PW_MAX];
    float ks[PW_MAX];
    float ws[PW_MAX];
#endif
    float q;
    int count;
    int slot;
};

// Wave i's fixed phase: the golden angle a wave, counted on from the rung
// under the lower one (wave_spectrum::sampleBlend).
float pwPhaseOffset(int i) {
    return (pwWindBlend.z * float(PW_COUNT) + float(i)) * 2.399963;
}

#ifndef WATER_FRAME_GLSLI
// One rung's 12 waves into sp from `base`, their sum of k a added to kaSum.
void pwSampleSet(inout PWSpectrum sp, int base, float ampScale, float fetch, float windMps, inout float kaSum) {
    float u = max(windMps * 1.0936133, 0.1);
    float f = max(fetch, 1.0);
    float wp = max(22.0 * pow(PW_G * PW_G / (u * f), 1.0 / 3.0), 0.855 * PW_G / u);
    float alpha = 0.076 * pow(u * u / (f * PW_G), 0.22);
    float lo = 0.70 * wp;
    float stepRatio = pow(4.0 / 0.70, 1.0 / float(PW_COUNT));

    for (int i = 0; i < PW_COUNT; i++) {
        float w0 = lo * pow(stepRatio, float(i));
        float w1 = w0 * stepRatio;
        float w = sqrt(w0 * w1);
        float sigma = w <= wp ? 0.07 : 0.09;
        float d = (w - wp) / (sigma * wp);
        float ratio = wp / w;
        float S = alpha * PW_G * PW_G / pow(w, 5.0) * exp(-1.25 * ratio * ratio * ratio * ratio)
                * pow(3.3, exp(-0.5 * d * d));
        sp.ws[base + i] = w;
        sp.ks[base + i] = w * w / PW_G;
        sp.amps[base + i] = sqrt(2.0 * S * (w1 - w0)) * ampScale;
        kaSum += sp.ks[base + i] * sp.amps[base + i];
    }
}

PWSpectrum pwSample(float ampScale, float fetch, float windMps) {
    PWSpectrum sp;
    sp.slot = -1;
    float kaSum = 0.0;
    float f = clamp(pwWindBlend.x, 0.0, 1.0);
    if (f > 0.0 && pwWindBlend.y > 0.0) {
        pwSampleSet(sp, 0, ampScale * sqrt(1.0 - f), fetch, windMps, kaSum);
        pwSampleSet(sp, PW_COUNT, ampScale * sqrt(f), fetch, pwWindBlend.y, kaSum);
        sp.count = PW_MAX;
    } else {
        pwSampleSet(sp, 0, ampScale, fetch, windMps, kaSum);
        sp.count = PW_COUNT;
    }
    sp.q = kaSum > 0.0 ? min(1.0, 0.75 / kaSum) : 0.0;
    return sp;
}
#else
// The frame's sampling made for these very arguments (pwSpecKey: the
// physics waves' push constants for a lake and for the sea, filled by
// WaterRenderer::fillWaveSpectra from the settings every surface is drawn
// with that frame). Every physics surface is one of the two, so one always
// matches; were none to, the one of the same fetch, or the lake's.
PWSpectrum pwSample(float ampScale, float fetch, float windMps) {
    PWSpectrum sp;
    sp.slot = pwSpecKey[2].x == fetch ? 1 : 0;
    for (int s = 0; s < 2; ++s) {
        vec4 a = pwSpecKey[2 * s];
        vec4 b = pwSpecKey[2 * s + 1];
        if (b.w > 0.5 && a.x == fetch && a.y == windMps && a.z == ampScale && a.w == pwWindBlend.x &&
            b.x == pwWindBlend.y) {
            sp.slot = s;
        }
    }
    sp.count = int(pwSpecKey[2 * sp.slot + 1].y);
    sp.q = pwSpecKey[2 * sp.slot + 1].z;
    return sp;
}
#endif

// --- The short waves' variety ---
// Twelve waves, each a set of straight crests at one length and heading,
// sum to a pattern that repeats: on a calm lake the short ones (the only ones
// a light wind raises) laid one fine regular weave over all of it, the same
// a few yards on as here. A light wind does not blow alike everywhere, and
// short waves are not so ordered: they come and go in patches (cat's paws)
// that drift downwind, their crests bend, and they run about more headings
// than the long ones. Waves shorter than the liquid grid carries
// (PW_VERTEX_MIN_WAVELENGTH, all of them on a lake in a light wind) are
// given that here, alike in every stage; the longer ones, which the vertex
// grid moves and the CPU rides (wave_surface.hpp), are left as they are.
// wave_surface.hpp's shortWaveVariety is the C++ twin.
//
// How strongly: pwVariety, from PW_VARIETY_STORM in a storm to
// PW_VARIETY_CALM in calm weather (each stage sets it from push.shore.w, the
// weather's calm: pwVarietyFromDetail).
const float PW_VARIETY_CALM = 0.85;
const float PW_VARIETY_STORM = 0.35;
// The patches' size and drift (yards, yards a second), and the crests'
// bending: how far, in radians of phase, over what distance.
const float PW_PATCH_SCALE = 1.0 / 26.0;
const float PW_PATCH_DRIFT = 0.8;
const float PW_BEND_SCALE = 1.0 / 11.0;
const float PW_BEND = 2.2;
// How much wider the short waves' headings spread than the long ones'.
const float PW_SHORT_SPREAD = 1.6;
float pwVariety = 0.0;
float pwVarietyFromDetail(float detailShare) {
    // detailShare is 1 - 0.75 calm (wave_spectrum::weatherWaves).
    float calm = clamp((1.0 - detailShare) / 0.75, 0.0, 1.0);
    return mix(PW_VARIETY_STORM, PW_VARIETY_CALM, calm);
}

// How short a wave of wavenumber k is: 1 well under the grid's shortest, 0
// at and over it.
float pwShortness(float k) {
    float wavelength = 6.2831853 / max(k, 1e-4);
    return 1.0 - smoothstep(0.75 * PW_VERTEX_MIN_WAVELENGTH, PW_VERTEX_MIN_WAVELENGTH, wavelength);
}

float pwHash(vec2 p) {
    p = fract(p * vec2(0.1031, 0.1030));
    p += dot(p, p.yx + 33.33);
    return fract((p.x + p.y) * p.x);
}
float pwNoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(pwHash(i), pwHash(i + vec2(1.0, 0.0)), f.x),
               mix(pwHash(i + vec2(0.0, 1.0)), pwHash(i + vec2(1.0, 1.0)), f.x), f.y);
}

// The three fields at `pos`, one per group of waves (wave i takes group
// i % 3): x the crests' bend (phase, radians), y the patches' height
// (1 - v to 1 + v, about 1 on average).
struct PWVarietyField {
    vec2 g[3];
};
PWVarietyField pwVarietyAt(vec2 pos, float time, float windDir) {
    PWVarietyField f;
    vec2 wind = vec2(cos(windDir), sin(windDir));
    for (int j = 0; j < 3; ++j) {
        vec2 o = vec2(float(j) * 37.17, float(j) * 59.83);
        float bend = (pwNoise(pos * PW_BEND_SCALE + o) - 0.5) * 2.0 * PW_BEND;
        float patchy = smoothstep(0.2, 0.8, pwNoise((pos - wind * (time * PW_PATCH_DRIFT)) * PW_PATCH_SCALE + o * 1.7));
        f.g[j] = vec2(bend, 1.0 - pwVariety + 2.0 * pwVariety * patchy);
    }
    return f;
}

// Wave i's direction: spread about the wind at fixed angles a golden-ratio
// step apart, the longest waves nearest the wind; the short ones (pwShortness)
// spread wider (PW_SHORT_SPREAD) when the variety is on.
vec2 pwDirection(int i, float windDir, float shortness) {
    // The upper rung's wave i + 12 runs as the lower's i.
    float spread = (fract(float(i % PW_COUNT) * 0.6180340) - 0.5) * 3.14159265 * 0.8;
    if (pwVariety > 0.0) spread *= 1.0 + (PW_SHORT_SPREAD - 1.0) * shortness;
    float angle = windDir + spread;
    return vec2(cos(angle), sin(angle));
}

// Wave i of a spectrum (pwSample): its wavenumber, angular frequency,
// amplitude and shortness (pwShortness).
vec4 pwWaveAt(PWSpectrum sp, int i) {
#ifdef WATER_FRAME_GLSLI
    return pwSpecWaves[sp.slot * PW_MAX + i];
#else
    return vec4(sp.ks[i], sp.ws[i], sp.amps[i], pwShortness(sp.ks[i]));
#endif
}

// Its heading (pwDirection). Worked out here, not read from the frame's
// block: a cosine and a sine cost the stage less than the block's reads did
// (0.3-0.9 ms of the water pass, Stonebull Lake and Ratchet's sea).
vec2 pwDirectionAt(PWSpectrum sp, int i, float windDir, float shortness) {
    return pwDirection(i, windDir, shortness);
}

// Its share of the slope variance, (k a)^2 / 2, before the patches: the
// frame's, worked out once on the CPU (pwSpecVariance, four to a vec4).
float pwVarianceAt(PWSpectrum sp, int i, vec4 wave) {
#ifdef WATER_FRAME_GLSLI
    int n = sp.slot * PW_MAX + i;
    return pwSpecVariance[n >> 2][n & 3];
#else
    return 0.5 * wave.x * wave.z * wave.x * wave.z;
#endif
}

// Set by a stage that reads neither the displacement nor the wave height of
// the waves it evaluates, only their slope (water.frag; the surf's crests
// where the waves break excepted: evaluatePhysicalWavesShore): the waves the
// normal leaves out (pwSlopeKeep 0) are then counted in hiddenSlope2 alone,
// not summed.
bool pwHeightUnused = false;

// How much of a wave `wavelength` yards long is moved as height: none under
// `minWavelength`, all over `fullWavelength`, faded in between (all or none
// at `minWavelength` when the two are the same).
float pwKeep(float wavelength, float minWavelength, float fullWavelength) {
    return fullWavelength > minWavelength
        ? clamp((wavelength - minWavelength) / (fullWavelength - minWavelength), 0.0, 1.0)
        : (wavelength >= minWavelength ? 1.0 : 0.0);
}

// Waves shorter than this, yards, are left out of the slope (the normal)
// as well, faded out over the next doubling of length: 0, as water.vert and
// water.tese leave it, keeps every wave in the normal. water.frag sets it to
// a few of the pixel's own widths on the water, so a wave shorter than the
// pixel can show is not sampled into a grid of glints that crawls as the
// camera moves (aliasing: the twelve waves' crests, each a set of straight
// lines, beat against the pixels' rows), and to more in calm weather, when
// the wind's short chop is what made a still lake look busy.
float pwSlopeCutoff = 0.0;
float pwSlopeKeep(float k) {
    return pwSlopeCutoff > 0.0 ? pwKeep(6.2831853 / max(k, 1e-4), pwSlopeCutoff, 2.0 * pwSlopeCutoff) : 1.0;
}

// The sampled spectrum's waves in deep water at `pos`. `slopeOnly`: the
// waves the normal leaves out are counted in hiddenSlope2 alone
// (pwHeightUnused).
GerstnerResult pwWaves(PWSpectrum sp, vec2 pos, float time, float windDir, float minWavelength,
                       float fullWavelength, bool slopeOnly) {
    GerstnerResult r = flatWaves();
    PWVarietyField vf;
    if (pwVariety > 0.0) vf = pwVarietyAt(pos, time, windDir);

    float totalWave = 0.0;
    for (int i = 0; i < sp.count; i++) {
        vec4 wave = pwWaveAt(sp, i);
        float k = wave.x;
        float shortness = wave.w;
        float patchA = 1.0;
        float Q = sp.q;
        float bend = 0.0;
        if (pwVariety > 0.0 && shortness > 0.0) {
            vec2 v = vf.g[i % 3];
            patchA = mix(1.0, v.y, shortness);
            // Never steeper than the spectrum's own: the patches raise a
            // wave by up to 1 + pwVariety.
            Q /= 1.0 + pwVariety * shortness;
            bend = v.x * shortness;
        }
        float A = wave.z * patchA;
        float slopeKeep = pwSlopeKeep(k);
        r.hiddenSlope2 += pwVarianceAt(sp, i, wave) * patchA * patchA * (1.0 - slopeKeep * slopeKeep);
        // Left out of the normal, and nothing else asked of it.
        if (slopeOnly && slopeKeep <= 0.0) continue;
        vec2 dir = pwDirectionAt(sp, i, windDir, shortness);
        // Too short for the vertex grid: in the normal only.
        float keep = pwKeep(6.2831853 / k, minWavelength, fullWavelength);
        float phase = k * dot(dir, pos) - wave.y * time + pwPhaseOffset(i) + bend;
        float s = sin(phase);
        float c = cos(phase);

        r.displacement.x += keep * Q * A * dir.x * c;
        r.displacement.y += keep * Q * A * dir.y * c;
        r.displacement.z += keep * A * s;

        float WA = k * A * slopeKeep;
        r.tangent.x -= Q * dir.x * dir.x * WA * s;
        r.tangent.y -= Q * dir.x * dir.y * WA * s;
        r.tangent.z += dir.x * WA * c;
        r.binormal.x -= Q * dir.x * dir.y * WA * s;
        r.binormal.y -= Q * dir.y * dir.y * WA * s;
        r.binormal.z += dir.y * WA * c;

        totalWave += keep * A * s;
    }
    r.waveHeight = totalWave;
    return r;
}

GerstnerResult evaluatePhysicalWavesFaded(vec2 pos, float time, float ampScale, float fetch, float windMps,
                                          float windDir, float minWavelength, float fullWavelength) {
    return pwWaves(pwSample(ampScale, fetch, windMps), pos, time, windDir, minWavelength, fullWavelength,
                   pwHeightUnused);
}

// The waves with a hard cut-off at `minWavelength` (water.vert, water.frag).
GerstnerResult evaluatePhysicalWaves(vec2 pos, float time, float ampScale, float fetch, float windMps,
                                     float windDir, float minWavelength) {
    return evaluatePhysicalWavesFaded(pos, time, ampScale, fetch, windMps, windDir, minWavelength, minWavelength);
}

GerstnerResult evaluateGerstnerWaves(vec2 pos, float time, float amp, float freq, float spd, float basicType) {
    GerstnerResult r = flatWaves();

    // Magma/slime: simple slow undulation
    if (basicType >= 1.5) {
        float wave = sin(pos.x * freq * 0.5 + time * spd * 0.3) * 0.4
                   + sin(pos.y * freq * 0.3 + time * spd * 0.5) * 0.3;
        r.displacement.z = wave * amp * 0.5;
        float dx = cos(pos.x * freq * 0.5 + time * spd * 0.3) * freq * 0.5 * amp * 0.5 * 0.4;
        float dy = cos(pos.y * freq * 0.3 + time * spd * 0.5) * freq * 0.3 * amp * 0.5 * 0.3;
        r.tangent = vec3(1.0, 0.0, dx);
        r.binormal = vec3(0.0, 1.0, dy);
        r.waveHeight = wave;
        return r;
    }

    // 6 wave directions for more chaotic, natural-looking water
    // Spread across many angles to avoid visible patterns
    vec2 dirs[6] = vec2[6](
        normalize(vec2(0.86, 0.51)),
        normalize(vec2(-0.47, 0.88)),
        normalize(vec2(0.32, -0.95)),
        normalize(vec2(-0.93, -0.37)),
        normalize(vec2(0.67, -0.29)),
        normalize(vec2(-0.15, 0.74))
    );
    float amps[6];
    float freqs[6];
    float spds_arr[6];
    float steepness[6];

    if (basicType > 0.5) {
        // Ocean: broader range of wave scales for realistic chop
        amps[0] = amp * 1.0;   amps[1] = amp * 0.55;  amps[2] = amp * 0.30;
        amps[3] = amp * 0.18;  amps[4] = amp * 0.10;  amps[5] = amp * 0.06;
        freqs[0] = freq * 0.7; freqs[1] = freq * 1.3;  freqs[2] = freq * 2.1;
        freqs[3] = freq * 3.4; freqs[4] = freq * 5.0;  freqs[5] = freq * 7.5;
        spds_arr[0] = spd * 0.8; spds_arr[1] = spd * 1.0; spds_arr[2] = spd * 1.3;
        spds_arr[3] = spd * 1.6; spds_arr[4] = spd * 2.0; spds_arr[5] = spd * 2.5;
        steepness[0] = 0.35; steepness[1] = 0.30; steepness[2] = 0.25;
        steepness[3] = 0.20; steepness[4] = 0.15; steepness[5] = 0.10;
    } else {
        // Inland water: gentle but multi-scale ripples
        amps[0] = amp * 0.5;   amps[1] = amp * 0.25;  amps[2] = amp * 0.15;
        amps[3] = amp * 0.08;  amps[4] = amp * 0.05;  amps[5] = amp * 0.03;
        freqs[0] = freq * 1.0; freqs[1] = freq * 1.8;  freqs[2] = freq * 3.0;
        freqs[3] = freq * 4.5; freqs[4] = freq * 7.0;  freqs[5] = freq * 10.0;
        spds_arr[0] = spd * 0.6; spds_arr[1] = spd * 0.9; spds_arr[2] = spd * 1.2;
        spds_arr[3] = spd * 1.5; spds_arr[4] = spd * 1.9; spds_arr[5] = spd * 2.3;
        steepness[0] = 0.20; steepness[1] = 0.18; steepness[2] = 0.15;
        steepness[3] = 0.12; steepness[4] = 0.10; steepness[5] = 0.08;
    }

    float totalWave = 0.0;
    for (int i = 0; i < 6; i++) {
        float w = freqs[i];
        float A = amps[i];
        float phi = spds_arr[i] * w; // phase speed
        float Q = steepness[i] / (w * A * 6.0);
        Q = clamp(Q, 0.0, 1.0);

        float phase = w * dot(dirs[i], pos) + phi * time;
        float s = sin(phase);
        float c = cos(phase);

        // Gerstner displacement: xy = horizontal, z = vertical (up)
        r.displacement.x += Q * A * dirs[i].x * c;
        r.displacement.y += Q * A * dirs[i].y * c;
        r.displacement.z += A * s;

        // Tangent/binormal accumulation for analytical normal
        float WA = w * A;
        r.tangent.x -= Q * dirs[i].x * dirs[i].x * WA * s;
        r.tangent.y -= Q * dirs[i].x * dirs[i].y * WA * s;
        r.tangent.z += dirs[i].x * WA * c;

        r.binormal.x -= Q * dirs[i].x * dirs[i].y * WA * s;
        r.binormal.y -= Q * dirs[i].y * dirs[i].y * WA * s;
        r.binormal.z += dirs[i].y * WA * c;

        totalWave += A * s;
    }

    r.waveHeight = totalWave;
    return r;
}

// --- Waves coming into shallow water (shallow_water.hpp is the C++ twin) ---
// The shore waves setting (push.shore.x) on terrain water. Each vertex knows
// the bed under it (WaterRenderer::loadFromTerrain): `bed` x is the depth to
// the ground, yards (negative over dry land), yz the way to the shallows
// (a unit vector where the bed slopes, shrinking to nothing where it is
// flat), w the bed's slope (rise over run).
//
// The phase, which must stay whole: each wave is split in two. The deep part
// keeps the deep-water phase k0 dir . x - omega t, whole everywhere, and only
// changes height. The shore part runs up the bed's slope with a phase that is
// a function of the depth alone (swShorePhase): the phase a long wave builds
// up running in over a beach of SW_REFERENCE_SLOPE. Its crests are the
// depth's contours, so they lie along the beach, and they close up and slow
// as the water shallows, as finite-depth dispersion has them; its wavelength
// is right on a beach of the reference slope only (longer on a gentler one,
// shorter on a steeper). Neither part takes a wavenumber that varies with
// the depth times the position, which is what tears the crests apart. The
// deep part hands its height to the shore part as the water shallows by
// Snell's law (swRefraction: 1 - c / c0 of the turn done). Both are raised
// by shoaling, held under McCowan's limit for the depth, steepened and leant
// shoreward as they break, and die away over the last half yard of depth.
const float SW_GAMMA = 0.78;            // McCowan: a wave breaks at 0.78 of the depth
const float SW_MAX_SHOALING = 2.5;
const float SW_FADE_DEPTH = 0.5;        // yards over which the waves die away at the waterline
const float SW_LIMIT_SHARPNESS = 6.0;
const float SW_HS_FACTOR = 2.8284271;   // significant height of waves with sum(a^2) = 1
const float SW_REFERENCE_SLOPE = 0.15;
const float SW_SHORE_PHASE_DEPTH = 0.15;
const float SW_SHORE_REACH_KH = 3.0;
// Past this k h for the longest wave the bed is not felt at all (deep water).
const float SW_DEEP_KH = 5.0;
const float SW_STEEPEN_FROM = 0.5;      // breaker index the steepening starts at
const float SW_BREAKING_AT = 1.0;
const float SW_BREAKING_STEEPNESS = 0.95;
const float SW_MAX_LEAN = 0.6;
// A shore wave shorter than this, yards, stays in the deep part: its crests,
// laid by the depth's contours, would come closer than the pixels on a steep
// bank.
const float SW_MIN_SHORE_WAVELENGTH = 1.0;

// tanh that does not overflow for a large argument (exp(x) / exp(x) is not a
// number on every driver).
float swTanh(float x) {
    float e = exp(-2.0 * abs(x));
    return sign(x) * (1.0 - e) / (1.0 + e);
}

// The wavenumber at depth h: omega^2 = g k tanh(k h), by Fenton and McKee's
// explicit approximation and one Newton step.
float swWavenumber(float omega, float h) {
    float k0 = omega * omega / PW_G;
    float hh = max(h, 1e-3);
    float k = k0 / pow(swTanh(pow(k0 * hh, 0.75)), 2.0 / 3.0);
    float th = swTanh(k * hh);
    float f = PW_G * k * th - omega * omega;
    float df = PW_G * (th + k * hh * (1.0 - th * th));
    return k - f / df;
}

// Shoaling, sqrt(cg_deep / cg), held at SW_MAX_SHOALING.
float swShoaling(float omega, float k, float h) {
    if (h <= 0.0) return SW_MAX_SHOALING;
    float x = 2.0 * k * h;
    // n = 1/2 (1 + 2kh / sinh 2kh), sinh by its exponentials.
    float e = exp(-x);
    float ratio = x > 20.0 ? 0.0 : (x > 1e-4 ? 2.0 * x * e / (1.0 - e * e) : 1.0);
    float cg = 0.5 * (1.0 + ratio) * omega / k;
    return min(sqrt(0.5 * PW_G / omega / cg), SW_MAX_SHOALING);
}

float swLimitScale(float breaker) {
    return breaker <= 0.0 ? 1.0 : 1.0 / pow(1.0 + pow(breaker, SW_LIMIT_SHARPNESS), 1.0 / SW_LIMIT_SHARPNESS);
}

float swFade(float h) { return smoothstep(0.0, SW_FADE_DEPTH, h); }

float swRefraction(float kh) {
    return (1.0 - swTanh(kh)) * (1.0 - smoothstep(0.66 * SW_SHORE_REACH_KH, SW_SHORE_REACH_KH, kh));
}

float swShoreReachDepth(float omega) {
    float r = SW_SHORE_REACH_KH / omega;
    return PW_G * r * r;
}

float swShorePhase(float omega, float h) {
    float d = clamp(h, 0.0, swShoreReachDepth(omega)) + SW_SHORE_PHASE_DEPTH;
    return 2.0 * omega / SW_REFERENCE_SLOPE * sqrt(d / PW_G);
}

float swShoreWavenumber(float omega, float h, float slope) {
    if (h > swShoreReachDepth(omega)) return 0.0;
    return omega / sqrt(PW_G * (max(h, 0.0) + SW_SHORE_PHASE_DEPTH)) * slope / SW_REFERENCE_SLOPE;
}

// One Gerstner wave added to `r`: running along `dir`, wavenumber `k`,
// height `A`, steepness `Q`, its crest leant forward by `lean` (that share of
// the height moved along `dir` with the crest: the front steepens and the
// back eases), `keep` of it moved as height.
void swAddWave(inout GerstnerResult r, vec2 dir, float k, float A, float Q, float lean, float phase,
               float keep) {
    float s = sin(phase);
    float c = cos(phase);
    float horizontal = Q * c + lean * s;
    r.displacement.x += keep * A * dir.x * horizontal;
    r.displacement.y += keep * A * dir.y * horizontal;
    r.displacement.z += keep * A * s;

    float slopeKeep = pwSlopeKeep(k);
    float WA = k * A * slopeKeep;
    r.hiddenSlope2 += 0.5 * k * A * k * A * (1.0 - slopeKeep * slopeKeep);
    float slope = lean * c - Q * s;
    r.tangent.x += dir.x * dir.x * WA * slope;
    r.tangent.y += dir.x * dir.y * WA * slope;
    r.tangent.z += dir.x * WA * c;
    r.binormal.x += dir.x * dir.y * WA * slope;
    r.binormal.y += dir.y * dir.y * WA * slope;
    r.binormal.z += dir.y * WA * c;

    r.waveHeight += keep * A * s;
}

// Wave i of `sp` (`wave`, pwWaveAt; its patches' height `patchA`) over a bed
// `h` deep: x its height there before the depth's limit (shoaled, died away
// by `fade`), y the share of it turned to run up the beach (toward
// `toShore`, on a bed of slope `bedSlope`, `sloped` of it sloping), z the
// shore part's wavenumber; `shoaled` its height before the fade.
vec3 swShoreHere(PWSpectrum sp, int i, vec4 wave, float patchA, float h, float fade, float bedSlope, float sloped,
                 vec2 toShore, float windDir, out float shoaled) {
    // A wave that does not feel the bed here (k h past SW_DEEP_KH, the whole
    // set's deep test for the longest in evaluatePhysicalWavesShore): its
    // deep self, shoaled by 1 (within 4e-4) and not turned (swRefraction is
    // 0 from k h = SW_SHORE_REACH_KH); the bed's math is left out for it.
    // Where the longest waves reach the bed, most shorter ones do not.
    if (wave.x * h > SW_DEEP_KH) {
        shoaled = wave.z * patchA;
        return vec3(shoaled * fade, 0.0, 0.0);
    }
    float w = wave.y;
    float k = swWavenumber(w, h);
    shoaled = wave.z * patchA * swShoaling(w, k, h);
    float kShore = swShoreWavenumber(w, h, bedSlope);
    // Only a wave running in toward the shore turns to it; one running out
    // to sea dies away in the shallows with its deep part.
    float toward = smoothstep(-0.2, 0.4, dot(pwDirectionAt(sp, i, windDir, wave.w), toShore));
    float longEnough = smoothstep(SW_MIN_SHORE_WAVELENGTH, 2.0 * SW_MIN_SHORE_WAVELENGTH,
                                  6.2831853 / max(kShore, 1e-4));
    return vec3(shoaled * fade, swRefraction(k * max(h, 0.0)) * sloped * toward * longEnough, kShore);
}

// The physics waves over the bed `bed` (above). Called with the same
// arguments from water.vert, water.tese and water.frag, so the surface and
// its shading agree.
GerstnerResult evaluatePhysicalWavesShore(vec2 pos, float time, float ampScale, float fetch, float windMps,
                                          float windDir, float minWavelength, float fullWavelength, vec4 bed) {
    PWSpectrum sp = pwSample(ampScale, fetch, windMps);
    float h = bed.x;
    float seaA2 = 0.0;
    for (int i = 0; i < sp.count; i++) {
        float a = pwWaveAt(sp, i).z;
        seaA2 += a * a;
    }
    // Deep enough that even the longest wave hardly feels the bed (shoaling
    // within a part in a thousand of 1, no turn, far from breaking): the deep
    // waves as they are, at a deep wave's cost.
    // Either rung's first wave is its longest.
    float longestK = sp.count > PW_COUNT ? min(pwWaveAt(sp, 0).x, pwWaveAt(sp, PW_COUNT).x) : pwWaveAt(sp, 0).x;
    if (h * longestK > SW_DEEP_KH) {
        float seaHeight = SW_HS_FACTOR * sqrt(seaA2);
        float breaking = seaHeight / (SW_GAMMA * h);
        // The wave height is the surf's (water.frag's surfFoam), which reads
        // it only where the breaker index, raised by at most 0.3 in a storm,
        // passes 0.7.
        bool slopeOnly = pwHeightUnused && breaking * 1.3 <= 0.7;
        GerstnerResult deep = pwWaves(sp, pos, time, windDir, minWavelength, fullWavelength, slopeOnly);
        deep.seaHeight = seaHeight;
        deep.breaking = breaking;
        return deep;
    }
    GerstnerResult r = flatWaves();
    PWVarietyField vf;
    if (pwVariety > 0.0) vf = pwVarietyAt(pos, time, windDir);
    float sloped = min(length(bed.yz), 1.0);
    vec2 toShore = sloped > 1e-4 ? normalize(bed.yz) : vec2(0.0);
    float bedSlope = max(bed.w, 0.0);
    float fade = swFade(h);

    // Each wave's height in this depth (before the depth's limit) and how
    // much of it has turned to run up the beach, and its wavenumber there
    // (swShoreHere), worked out in each of the two passes below rather than
    // held in arrays: three arrays of 24 a pixel cost the stage more than
    // working them out twice.
    float sumA2 = 0.0;
    float shoaledA2 = 0.0;
    float kaRaw = 0.0;
    for (int i = 0; i < sp.count; i++) {
        vec4 wave = pwWaveAt(sp, i);
        float patchA = pwVariety > 0.0 ? mix(1.0, vf.g[i % 3].y, wave.w) : 1.0;
        float shoaled;
        vec3 here = swShoreHere(sp, i, wave, patchA, h, fade, bedSlope, sloped, toShore, windDir, shoaled);
        shoaledA2 += shoaled * shoaled;
        sumA2 += here.x * here.x;
        kaRaw += here.x * mix(wave.x, here.z, here.y);
    }

    // Held under the depth's limit, smoothly, and steepened and leant
    // shoreward as they come to break, with sum(k a) sqrt(Q^2 + lean^2)
    // kept under 1 so the surface never folds.
    float breaker = SW_HS_FACTOR * sqrt(sumA2) / (SW_GAMMA * max(h, 1e-3));
    float limit = swLimitScale(breaker);
    float kaSum = kaRaw * limit;
    float b = smoothstep(SW_STEEPEN_FROM, SW_BREAKING_AT, breaker);
    float budget = mix(0.75, SW_BREAKING_STEEPNESS, b);
    float leanShare = SW_MAX_LEAN * b;
    float Q = kaSum > 0.0 ? min(1.0, budget / (kaSum * sqrt(1.0 + leanShare * leanShare))) : 0.0;
    float lean = leanShare * Q;

    float shoreA = 0.0;
    float totalA = 0.0;
    float strongest = 0.0;
    for (int i = 0; i < sp.count; i++) {
        vec4 wave = pwWaveAt(sp, i);
        float k = wave.x;
        float shortness = wave.w;
        vec2 dir = pwDirectionAt(sp, i, windDir, shortness);
        float w = wave.y;
        float patchA = pwVariety > 0.0 ? mix(1.0, vf.g[i % 3].y, shortness) : 1.0;
        float shoaled;
        vec3 here = swShoreHere(sp, i, wave, patchA, h, fade, bedSlope, sloped, toShore, windDir, shoaled);
        float A = here.x * limit;
        float share = here.y;
        float kShore = here.z;
        float offset = pwPhaseOffset(i);
        // The short waves' crests bent on deep water (pwVarietyAt); the
        // shore part's crests are the depth's contours and stay so.
        float bend = pwVariety > 0.0 ? vf.g[i % 3].x * shortness : 0.0;
        // The deep part, at its deep phase.
        float deepA = A * (1.0 - share);
        swAddWave(r, dir, k, deepA, Q, lean, k * dot(dir, pos) - w * time + offset + bend,
                  pwKeep(6.2831853 / k, minWavelength, fullWavelength));
        // The shore part, at the phase the depth gives it.
        float shoreAmp = A * share;
        if (shoreAmp > 0.0) {
            float phase = -swShorePhase(w, h) - w * time + offset;
            swAddWave(r, toShore, kShore, shoreAmp, Q, lean, phase,
                      pwKeep(6.2831853 / max(kShore, 1e-4), minWavelength, fullWavelength));
            if (shoreAmp > strongest) {
                strongest = shoreAmp;
                r.shorePhase = phase;
            }
        }
        shoreA += shoreAmp;
        totalA += A;
    }
    // The surf's breaker index (water.frag's surfFoam) is the waves' before
    // they die away at the waterline (swFade): a wave that comes in breaks
    // there, it does not fade out unbroken. Taken after the fade, the index
    // fell to nothing toward the waterline faster than the depth did, and on
    // a lake no wave ever reached 1 anywhere - no surf at any shore but the
    // open sea's. The surface itself is still held by the faded one above.
    r.breaking = SW_HS_FACTOR * sqrt(shoaledA2) / (SW_GAMMA * max(h, 1e-3));
    r.shoreWeight = totalA > 0.0 ? shoreA / totalA : 0.0;
    r.seaHeight = SW_HS_FACTOR * sqrt(seaA2);
    return r;
}

// The hand-made waves over the bed: only held under the depth's limit and
// died away at the waterline, the whole set scaled alike (they have no
// dispersion to shoal or turn by).
GerstnerResult evaluateGerstnerWavesShore(vec2 pos, float time, float amp, float freq, float spd, float basicType,
                                          vec4 bed) {
    GerstnerResult r = evaluateGerstnerWaves(pos, time, amp, freq, spd, basicType);
    if (basicType >= 1.5) return r;
    // The six waves' sum of squared heights over amp^2 (evaluateGerstnerWaves'
    // ocean and inland sets).
    float sumA2 = amp * amp * (basicType > 0.5 ? 1.4385 : 0.3448);
    float h = bed.x;
    float fade = swFade(h);
    r.seaHeight = SW_HS_FACTOR * sqrt(sumA2);
    // The surface is held by the faded heights; the surf's breaker index
    // (r.breaking) by the waves' own, as evaluatePhysicalWavesShore has it.
    float scale = fade * swLimitScale(r.seaHeight * fade / (SW_GAMMA * max(h, 1e-3)));
    r.breaking = r.seaHeight / (SW_GAMMA * max(h, 1e-3));
    r.displacement *= scale;
    r.tangent = vec3(1.0, 0.0, 0.0) + (r.tangent - vec3(1.0, 0.0, 0.0)) * scale;
    r.binormal = vec3(0.0, 1.0, 0.0) + (r.binormal - vec3(0.0, 1.0, 0.0)) * scale;
    r.waveHeight *= scale;
    return r;
}

#endif
