// The sun's cascaded shadow map, as every lit surface reads it.
//
// The renderer draws one to three cascades into tiles of a single depth atlas
// (Renderer::computeLightSpaceMatrix): concentric squares centred on the
// player, the same light direction and the same depth range for all of them,
// only the half-extent differs - about 50 and 300 yards with two at the
// default shadow distance. A cascade's matrix takes a world position straight
// to its tile's atlas UV and to a depth, so nothing here scales or offsets.
//
// The including shader declares, in its PerFrame block, after everything the
// renderer's GPUPerFrameData has before them:
//     mat4 cascadeMatrix[4];  // world -> atlas uv.xy, depth z
//     vec4 cascadeRect[4];    // the tile: uv min xy, uv max zw
//     vec4 cascadeTexel[4];   // x one texel in yards, yz one atlas texel in u, v
//     vec4 cascadeInfo;       // x count (0 = no map), y 1 for the cheap filter, z fade start
//
// cascadeInfo.x is 0 in the character preview, whose block is zeroed, and
// before the player has a position; everything then reads as lit.

// How far into a tile, as a fraction of its half-width from the centre: 0 at
// the centre, 1 on the edge - the client's max(|x|, |y|) on a cascade's
// -1..1 coordinates.
float csmTileDistance(int c, vec2 uv) {
    const vec4 rect = cascadeRect[c];
    const vec2 d = abs((uv - rect.xy) / (rect.zw - rect.xy) * 2.0 - 1.0);
    return max(d.x, d.y);
}

// One cascade's 3x3 filter, the taps held to its tile so none reads the
// neighbouring one. With cascadeInfo.y set (a phone, or the Low preset:
// Renderer::setLowCostShading) it is four taps half a texel either side of
// the point instead of nine a texel apart - each tap is the sampler's own
// 2x2 compare, so the four still cover the same 3x3 texels, with a little
// less smoothing across them. The point is moved along the surface normal by up to one
// and a half of this cascade's texels, in yards, before it is projected.
float csmSampleCascade(sampler2DShadow smap, int c, vec3 worldPos, vec3 n, float nl,
                       float depthBias) {
    const float offset = 1.5 * cascadeTexel[c].x * clamp(1.0 - abs(nl), 0.3, 1.0);
    const vec4 ls = cascadeMatrix[c] * vec4(worldPos + n * offset, 1.0);
    const vec3 proj = ls.xyz / ls.w;
    if (proj.z < 0.0 || proj.z > 1.0) return 1.0;
    const vec2 texel = cascadeTexel[c].yz;
    // Half a texel in, so a bilinear compare stays inside the tile too.
    const vec2 lo = cascadeRect[c].xy + 0.5 * texel;
    const vec2 hi = cascadeRect[c].zw - 0.5 * texel;
    const float ref = proj.z - depthBias;
    if (cascadeInfo.y > 0.5) {
        float quad = 0.0;
        for (int x = 0; x < 2; ++x) {
            for (int y = 0; y < 2; ++y) {
                const vec2 uv = clamp(proj.xy + (vec2(x, y) - 0.5) * texel, lo, hi);
                quad += texture(smap, vec3(uv, ref));
            }
        }
        return quad * 0.25;
    }
    float sum = 0.0;
    for (int x = -1; x <= 1; ++x) {
        for (int y = -1; y <= 1; ++y) {
            const vec2 uv = clamp(proj.xy + vec2(x, y) * texel, lo, hi);
            sum += texture(smap, vec3(uv, ref));
        }
    }
    return sum / 9.0;
}

// The light let through at worldPos, 1 lit and 0 shadowed, before the shadow
// strength. n is the surface normal, nl its dot with the direction to the sun
// and depthBias what is taken off the depth (the shader's own, as before).
//
// The cascade is chosen as the client's cascaded pixel shaders choose it
// (combiners_*, mapobj*, terrain3*; e.g. nvfp2 combiners_opaque, variant 2,
// with the three cascades FUN_00875d30 makes at extShadowQuality 3 and up):
// the first whose coordinates have max(|x|, |y|) < 1, strictly and with no
// inset, and nothing blended between them - the switch to the next one is a
// hard line. The last cascade is read wherever no finer one holds the point,
// untested, and its shadow fades out to fully lit from 90% of its half-width
// to 99% of it: saturate(11 - 11.111111 * max(|x|, |y|)).
float csmShadow(sampler2DShadow smap, vec3 worldPos, vec3 n, float nl, float depthBias) {
    const int count = min(int(cascadeInfo.x + 0.5), 4);
    for (int c = 0; c < count; ++c) {
        const vec4 ls = cascadeMatrix[c] * vec4(worldPos, 1.0);
        const float d = csmTileDistance(c, ls.xy / ls.w);
        if (c + 1 < count) {
            if (d < 1.0) return csmSampleCascade(smap, c, worldPos, n, nl, depthBias);
            continue;
        }
        const float start = min(cascadeInfo.z, 0.99 - 1e-3);
        const float fade = clamp((d - start) / (0.99 - start), 0.0, 1.0);
        if (fade >= 1.0) return 1.0;
        return mix(csmSampleCascade(smap, c, worldPos, n, nl, depthBias), 1.0, fade);
    }
    return 1.0;
}
