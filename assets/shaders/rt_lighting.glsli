// Ray traced lighting as the surface shaders read it (RtLighting).
//
// The sun and occlusion were traced last frame, so a surface finds its texels
// by projecting its world position with that frame's matrix, and trusts them
// only where the distance stored there matches its own - anything else is a
// surface that was hidden, off screen or somewhere else last frame. Where
// nothing matches it borrows from the nearest texel at its distance a little
// farther out (rtLightAt), and only where there is none either does every
// term fall back to what the shader computed without ray tracing.
//
// The bounced light comes from the probe volume (RtGiProbes, rt_gi.glsli),
// which a surface reads at its own position and normal, so it has no such
// gaps; outside the volume it fades to the flat ambient.
//
// The point lights - torches, braziers, lamps (rt_point_lights.hpp) - come
// the same way as the sun: their light unshadowed in uRtPointLight, the
// fraction of it that arrives beside the sun's visibility, multiplied
// together here. The original lights nothing with them at runtime, so a
// surface adds that light to its own (rtPointLight) only where there is a
// result - except a building's own lights, which its interior has baked into
// its colours already: there they only cast their shadows (rtPointLightOwn,
// rtBakedShade).
//
// The including shader must declare, in its PerFrame block, view, projection,
// viewPos and:
//     mat4 rtViewProj;   // the frame the result was traced in
//     vec4 rtCameraPos;  // its camera position
//     vec4 rtParams;     // x = mode (0 off, 1 sun, 2 +AO, 3 +probe light),
//                        // z = 1: borrow nothing this frame (a room changed)
// and after the shadow cascades at its end:
//     vec4 giVolume[2];
//     vec4 giVolumeMod[2];
//     vec4 giSky;        // w = strength
//     vec4 giGround;     // w = largest ratio
//     vec4 giParams;     // x = on, y = debug view, z = chroma
//     vec4 rtTune;       // x shadow darkness, y point lights, z baked-lamp
//                        // shadows; w 1 when these three blocks are set
//     vec4 lightTune;    // x baked light, y traced sun shadows, z point
//                        // lights' shadows, w traced occlusion
//     vec4 rtTune2;      // x the probes' bounced light

#include "rt_gi.glsli"

layout(set = 0, binding = 3) uniform sampler2D uRtLight;     // r sun, g AO, b point lights' share, a distance
layout(set = 0, binding = 4) uniform sampler2D uRtGiProbes;  // the probe atlas
layout(set = 0, binding = 5) uniform sampler2D uRtPointLight;  // rgb the point lights unshadowed, a the baked ones' part

struct RtLight {
    float weight;
    float sun;
    float ao;
    vec3 point;       // the point lights' light here, shadowed, times weight
    vec3 pointOwn;    // the same less the buildings' own (baked) lights
    float bakedShade; // what those lights' shadows leave of a baked colour
};

// How much of a baked colour a lamp's shadow takes, where the lamp alone
// lights it fully. Not all of it: the bake holds the room's ambient and its
// other lamps too, and it is a vertex colour - an average over a polygon
// that may reach well past the shadow. The Debug Graphics settings can move
// it (rtTune.z).
const float RT_BAKED_SHADOW = 0.6;
float rtBakedShadowStrength() { return rtTune.w > 0.5 ? rtTune.z : RT_BAKED_SHADOW; }
float rtPointStrength() { return rtTune.w > 0.5 ? rtTune.y : 1.0; }

// The baked light's strength - an interior's vertex colours, a doodad's MODD
// colour, a unit's floor colour: 1 as the client has it, with or without
// the ray tracing (the Debug Graphics settings, lightTune.x).
float rtBakedLight() { return rtTune.w > 0.5 ? lightTune.x : 1.0; }

// How much of each traced term shows, 1 as traced (the Debug Graphics
// settings): the sun's shadows, the point lights' shadows, the occlusion
// and the probes' bounced light.
float rtSunShadowStrength() { return rtTune.w > 0.5 ? lightTune.y : 1.0; }
float rtPointShadowStrength() { return rtTune.w > 0.5 ? lightTune.z : 1.0; }
float rtAoStrength() { return rtTune.w > 0.5 ? lightTune.w : 1.0; }
float rtBounceStrength() { return rtTune.w > 0.5 ? rtTune2.x : 1.0; }

// What WOWEE_GI_DEBUG shows instead of the surface, when it shows anything.
vec3 rtGiDebugColour = vec3(0.0);
bool rtGiDebugSet = false;

// WOWEE_GI_DEBUG 5, 6 and 7, in Full mode: the traced sun's visibility (red
// where there is no result, tinted orange where it was borrowed from beside
// it), the point lights' light as it is added, and the traced occlusion.
RtLight rtLightDebug(RtLight r) {
    int debugView = int(giParams.y + 0.5);
    if (debugView == 5) {
        rtGiDebugSet = true;
        rtGiDebugColour = r.weight > 0.0 ? vec3(r.sun) : vec3(1.0, 0.0, 0.0);
    } else if (debugView == 6) {
        rtGiDebugSet = true;
        rtGiDebugColour = r.point;
    } else if (debugView == 7) {
        rtGiDebugSet = true;
        rtGiDebugColour = r.weight > 0.0 ? vec3(r.ao) : vec3(1.0, 0.0, 0.0);
    }
    return r;
}

// One texel of the result into the running sums, by weight w: the sun and
// the occlusion; the point lights' light that arrives, and of it the baked
// lights' (brightest channel's worth); and the baked lights' that does not.
void rtGather(ivec2 q, vec4 l, float w, inout vec2 sunAo, inout vec4 point, inout float bakedDark) {
    vec4 p = texelFetch(uRtPointLight, q, 0);
    float vis = l.b;
    point += p * (mix(1.0, vis, rtPointShadowStrength()) * w);
    bakedDark += min(p.a, 1.0) * (1.0 - vis) * w;
    sunAo += l.rg * w;
}

// Set by a shader drawing what moves on its own - a unit, what it carries,
// a door or a lift (character.frag, m2.frag) - before rtLightAt, which it
// hands where the surface was when the result was traced: its vertex shader
// places it a second time with last frame's placement and pose.
bool rtSurfaceIsUnit = false;

// The distance a texel of the result stands for, 0 where it is no use to
// this surface. A mover's texels carry theirs negated (rt_filter): those
// serve only movers. A mover moves on its own, and the result is a frame
// old, so the ground a body has just walked off, or swung an arm or a staff
// away from, finds the body's texels where it lies - lit as the body was.
// Weighed in, they matched the ground at the feet; refused, they left it
// with nothing, drawn without the tracing: either way a copy of the body,
// a frame behind, in other light. Refused, such a surface borrows (below).
float rtTexelDist(vec4 l) {
    return l.a < 0.0 && !rtSurfaceIsUnit ? 0.0 : abs(l.a);
}

// The same for a texel borrowed from beside: only another mover's for a
// mover - the body's own texels a little further on - and only what stands
// still for the rest, never the light of another object.
float rtBorrowDist(vec4 l) {
    return (l.a < 0.0) == rtSurfaceIsUnit ? abs(l.a) : 0.0;
}

// The result is traced at half resolution, so a surface's texel neighbours
// can be other surfaces - most of all along an object's silhouette, where a
// single filtered read would average the object with what is behind it, fail
// the distance test and drop the pixel to the fallback: a bright rim. So the
// 3x3 texels around the nearest one are weighed individually, by how close
// they are and whether their stored distance is this surface's, and only the
// matching ones are blended.
//
// The result is last frame's. Where the view turned or something moved, a
// surface can find nothing of itself there: the strip of ground a body has
// just uncovered as the camera swings round it, the edge of the screen the
// view turns toward. Falling back to the shading without tracing there drew
// a band of other light along every silhouette and screen edge while
// turning, a smear trailing whatever moved. Such a surface borrows the
// light of the nearest texel farther out that lies at its distance - the
// same ground or wall a few texels on - which is what it most likely had.
RtLight rtLightAt(vec3 worldPos) {
    RtLight r = RtLight(0.0, 1.0, 1.0, vec3(0.0), vec3(0.0), 1.0);
    if (rtParams.x < 0.5) return r;
    vec4 clip = rtViewProj * vec4(worldPos, 1.0);
    if (clip.w <= 0.0) return r;
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    // Up to a tenth of the screen past an edge borrows from that edge.
    if (any(lessThan(uv, vec2(-0.1))) || any(greaterThan(uv, vec2(1.1)))) return rtLightDebug(r);
    bool onScreen = all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)));
    uv = clamp(uv, vec2(0.0), vec2(1.0));

    ivec2 size = textureSize(uRtLight, 0);
    vec2 f = uv * vec2(size) - 0.5;
    ivec2 center = ivec2(floor(f + 0.5));
    float expected = length(worldPos - rtCameraPos.xyz);
    float tolerance = 0.03 * expected + 0.05;

    float wsum = 0.0;
    float best = 0.0;
    vec2 sunAo = vec2(0.0);
    vec4 point = vec4(0.0);
    float bakedDark = 0.0;
    float weight = 0.0;
    if (onScreen) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec2 q = clamp(center + ivec2(x, y), ivec2(0), size - 1);
                vec4 l = texelFetch(uRtLight, q, 0);
                float d = rtTexelDist(l);
                float e = (d - expected) / tolerance;
                float match = d > 0.0 ? exp(-e * e) : 0.0;
                vec2 o = vec2(q) - f;
                float w = match * exp(-dot(o, o));
                if (w <= 1e-4) continue;
                best = max(best, match);
                wsum += w;
                rtGather(q, l, w, sunAo, point, bakedDark);
            }
        }
        if (wsum > 1e-4) weight = smoothstep(0.1, 0.6, best);
        // Only texels a little off its distance: as good as none, and then it
        // may borrow below rather than be drawn without the tracing.
        if (weight <= 0.0) {
            wsum = 0.0;
            sunAo = vec2(0.0);
            point = vec4(0.0);
            bakedDark = 0.0;
        }
    }

    // Nothing of this surface here: the best texel at its distance in eight
    // directions at 3, 8 and 20 texels, nearest ring first, a little looser
    // in the distance the farther out it is. Borrowed, so trusted a little
    // less than a surface's own; the shadow map keeps its say through
    // rtShadow.
    //
    // Only for a surface that something well in front of it hid last frame
    // and that has come out from behind it since - a body, a pillar, a
    // wall's edge the view has swung past - or that was off the screen's
    // edge or against the sky. Nothing is drawn depth first here, so most
    // surfaces something nearer hid last frame are hidden still: drawn
    // before what covers them, and about to be painted over. That occluder,
    // put back where last frame saw it along the same line of sight and
    // projected with this frame's camera, still covers this pixel for those;
    // searching on each of them cost as much as the rest of the lighting
    // together. Nor is it for one in front of what was traced there (glass,
    // water, a leaf the half resolution missed), or ground among grass
    // blades, which has a blade a hand's breadth in front of it everywhere:
    // nothing of its own is near for those.
    //
    // Except where what stood in front was a unit, or this surface is one:
    // a unit moves on its own, and the occluder put back where last frame
    // saw it is where the body was, not where it is - for the player's own
    // body, which the camera follows, it lands on the very ground the body
    // has just walked off, and that ground was drawn without the tracing, a
    // copy of the body a frame behind it in other light. Units are few and
    // small on the screen; they borrow always, and trust what they borrow as
    // their own - the same ground a few texels on - as anything less leaves
    // that copy in part.
    float thereSigned = texelFetch(uRtLight, clamp(center, ivec2(0), size - 1), 0).a;
    float there = abs(thereSigned);
    bool moved = onScreen && wsum <= 1e-4 && (thereSigned < 0.0 || rtSurfaceIsUnit);
    bool hidden = !onScreen || there <= 0.0 || moved;
    if (!hidden && wsum <= 1e-4 && there < 0.85 * expected - tolerance) {
        vec3 occluder = rtCameraPos.xyz + (worldPos - rtCameraPos.xyz) * (there / expected);
        vec4 a = projection * (view * vec4(worldPos, 1.0));
        vec4 b = projection * (view * vec4(occluder, 1.0));
        vec2 apart = (a.xy / a.w - b.xy / max(b.w, 1e-4)) * 0.5 * vec2(size);
        hidden = b.w <= 0.0 || dot(apart, apart) > 2.25;
    }
    bool borrowed = false;
    // Just after a room was entered or left the history starts afresh, and
    // nothing is borrowed either: what is beside may be the other room.
    if (rtParams.z > 0.5) hidden = false;
    for (int ring = 0; ring < 3 && hidden && wsum <= 1e-4; ++ring) {
        int reach = ring == 0 ? 3 : (ring == 1 ? 8 : 20);
        float ringTolerance = tolerance * (1.0 + 0.5 * float(ring));
        float ringBest = 0.0;
        ivec2 ringAt = ivec2(0);
        vec4 ringLight = vec4(0.0);
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                if (x == 0 && y == 0) continue;
                ivec2 q = clamp(center + ivec2(x, y) * reach, ivec2(0), size - 1);
                vec4 l = texelFetch(uRtLight, q, 0);
                float d = rtBorrowDist(l);
                float e = (d - expected) / ringTolerance;
                float match = d > 0.0 ? 1.0 - e * e : 0.0;
                if (match > ringBest) {
                    ringBest = match;
                    ringAt = q;
                    ringLight = l;
                }
            }
        }
        if (ringBest > 0.0) {
            wsum = 1.0;
            rtGather(ringAt, ringLight, 1.0, sunAo, point, bakedDark);
            weight = (moved ? 1.0 : 0.8) * smoothstep(0.0, 0.75, ringBest);
            borrowed = true;
        }
    }
    // Still nothing, for what stands still: then it stands inside a mover's
    // box itself - a fence post a unit leans on, a table it stands at - and
    // is its own texels there, which carry the mover's sign. Taken back at a
    // tighter distance than above, where a body could not be.
    if (wsum <= 1e-4 && onScreen && !rtSurfaceIsUnit && rtParams.z < 0.5) {
        float tight = 0.01 * expected + 0.03;
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec2 q = clamp(center + ivec2(x, y), ivec2(0), size - 1);
                vec4 l = texelFetch(uRtLight, q, 0);
                float e = (abs(l.a) - expected) / tight;
                float match = l.a < 0.0 ? exp(-e * e) : 0.0;
                vec2 o = vec2(q) - f;
                float w = match * exp(-dot(o, o));
                if (w <= 1e-4) continue;
                best = max(best, match);
                wsum += w;
                rtGather(q, l, w, sunAo, point, bakedDark);
            }
        }
        if (wsum > 1e-4) weight = smoothstep(0.1, 0.6, best);
    }
    if (int(giParams.y + 0.5) == 8) {
        // How well the surface found itself: green its own, orange borrowed,
        // red nothing; blue where it moves on its own.
        rtGiDebugSet = true;
        rtGiDebugColour = wsum <= 1e-4 ? vec3(1.0, 0.0, 0.0)
                        : borrowed ? vec3(1.0, 0.5, 0.0) : vec3(1.0 - weight, weight, 0.0);
        if (rtSurfaceIsUnit) rtGiDebugColour = mix(rtGiDebugColour, vec3(0.0, 0.0, 1.0), 0.35);
    }
    if (wsum <= 1e-4) return rtLightDebug(r);

    r.weight = weight;
    r.sun = sunAo.x / wsum;
    r.ao = sunAo.y / wsum;
    r.point = point.rgb / wsum * (weight * rtPointStrength());
    // The other lights' part: the whole less the baked lights' share of it.
    float total = max(point.r, max(point.g, point.b));
    r.pointOwn = r.point * (total > 1e-4 ? clamp(1.0 - point.a / total, 0.0, 1.0) : 1.0);
    r.bakedShade = 1.0 - rtBakedShadowStrength() * weight * bakedDark / wsum;
    r = rtLightDebug(r);
    if (borrowed && rtGiDebugSet && int(giParams.y + 0.5) == 5) {
        rtGiDebugColour = mix(vec3(1.0, 0.5, 0.0), rtGiDebugColour, 0.5);
    }
    return r;
}

// A unit drawn see-through finds nothing of itself in the result: where its
// depth is, the G-buffer holds what shows through it (rt_prepare). It is lit
// as the result would light it, without what the result holds of it: the
// shadow map's shadow at the traced shadow's strength, no occlusion, and the
// point lights of what stands right behind it, which it shares a place
// with - not the bare fallback, whose weaker shadow and missing torchlight
// would change the body's light the moment it begins to fade.
RtLight rtLightSeeThrough(vec3 worldPos) {
    RtLight r = RtLight(0.0, 1.0, 1.0, vec3(0.0), vec3(0.0), 1.0);
    if (rtParams.x < 0.5) return r;
    vec4 clip = rtViewProj * vec4(worldPos, 1.0);
    if (clip.w <= 0.0) return r;
    vec2 uv = clamp(clip.xy / clip.w * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    ivec2 size = textureSize(uRtLight, 0);
    ivec2 center = ivec2(uv * vec2(size));
    vec2 sunAo = vec2(0.0);
    vec4 point = vec4(0.0);
    float bakedDark = 0.0;
    float wsum = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = clamp(center + ivec2(x, y), ivec2(0), size - 1);
            vec4 l = texelFetch(uRtLight, q, 0);
            if (l.a == 0.0) continue;
            rtGather(q, l, 1.0, sunAo, point, bakedDark);
            wsum += 1.0;
        }
    }
    r.weight = 1.0;
    if (wsum > 0.0) {
        r.point = point.rgb / wsum * rtPointStrength();
        float total = max(point.r, max(point.g, point.b));
        r.pointOwn = r.point * (total > 1e-4 ? clamp(1.0 - point.a / total, 0.0, 1.0) : 1.0);
    }
    return rtLightDebug(r);
}

// The traced shadow and the shadow map combined, the lesser of the two. The
// traced one alone would do for the world and for the units near the camera;
// the units it carries in a standing pose (character_renderer_rt.cpp) cast
// their true pose into the map, and the two together keep that one.
float rtShadow(RtLight r, float shadowMap) {
    return min(shadowMap, mix(1.0, r.sun, r.weight * rtSunShadowStrength()));
}

// How far the shadow variants let a face turned edge-on to the sun out of
// the shadow map's shadow: |1.2 - |N.L||^4, saturated (c4 is the light's
// view-space direction, 0x00875c10). That is for the client's coarse map,
// whose depth test cannot tell a face it grazes from what shades it: it
// clears the acne on such a face, and with it any shadow at all on flat
// ground under a low light - half of one at twenty degrees. A traced ray
// starts off the surface and knows the difference, so its shadow is not
// lifted: a tree's or a house's would otherwise half vanish from the ground
// and the grass on it in the evening.
float rtEdgeOnLift(vec3 n, vec3 toLight) {
    return clamp(pow(abs(1.2 - abs(dot(n, toLight))), 4.0), 0.0, 1.0);
}

// rtShadow with the map's shadow lifted on an edge-on face first, and the
// traced one taken as it is.
float rtShadowEdgeOn(RtLight r, float shadowMap, vec3 n, vec3 toLight) {
    return rtShadow(r, shadowMap + (1.0 - shadowMap) * rtEdgeOnLift(n, toLight));
}

// The point lights' light on this surface, to add to the light it is lit
// by; nothing without a result.
vec3 rtPointLight(RtLight r) {
    return r.point;
}

// The same for a surface whose colour is a building's baked light - an
// interior's vertex colours, a doodad's MODD colour, a unit's floor colour.
// That colour holds the building's own lamps already, unshadowed: only the
// other lights are added (M2 lights, fires), and the lamps' shadows darken
// the baked colour instead (rtBakedShade).
vec3 rtPointLightOwn(RtLight r) {
    return r.pointOwn;
}

// What to scale a baked colour by for the shadows the building's lamps cast
// across it - a unit, a table, a pillar between a lamp and the floor.
float rtBakedShade(RtLight r) {
    return r.bakedShade;
}

// What the shadow variants scale a lit colour by: 0.7 + 0.3 x the light let
// through, as the client's pixel programs have it, made for its coarse soft
// map - a shadow that only hints. Where the shadow is traced it is sharp and
// true to its caster, and a unit standing in the sun should be seen to cast
// one: 0.4 + 0.6 x the light, still above the flat ambient alone. The Debug
// Graphics settings can move the 0.6 (rtTune.x).
const float RT_SHADOW_STRENGTH = 0.6;
float rtShadowScale(RtLight r, float shadow) {
    float k = rtTune.w > 0.5 ? rtTune.x : RT_SHADOW_STRENGTH;
    return mix(0.7 + 0.3 * shadow, (1.0 - k) + k * shadow, r.weight);
}

// The flat ambient darkened by the traced occlusion: for what the probes must
// not light (an interior's own ambient), and the rest of it below Full.
vec3 rtAmbient(RtLight r, vec3 flatAmbient) {
    if (rtParams.x < 1.5) return flatAmbient;
    return mix(flatAmbient, flatAmbient * r.ao, r.weight * rtAoStrength());
}

// How much more or less light than an open field the probes say a surface at
// worldPos facing n gets. The original has no bounced light at all; its
// Light.dbc ambient is the open field's (0x007ee750 and the curves behind
// it), and the artists tuned every zone's colours on that. Taking the probes'
// irradiance as the ambient would throw those colours away - the old
// one-bounce mode did, and darkened everything turned away from the sky. As a
// ratio against the open field (giOpenReference, giAmbientRatio) the probes
// leave a meadow as it was authored at every orientation, and darken the
// underside of a bridge, an alley, a doorway; light a shaded wall from the
// sunlit one across from it; and warm the ground beside a red cliff a little.
vec3 rtGiRatio(vec3 worldPos, vec3 n) {
    vec3 v = normalize(viewPos.xyz - worldPos);
    vec4 e = giIrradiance(uRtGiProbes, giVolume[0], giVolumeMod[0], giVolume[1], giVolumeMod[1],
                          worldPos, n, v);
    float lift = texelFetch(uRtGiProbes, GI_EXPOSURE_TEXEL, 0).r;
    vec3 ratio = giAmbientRatio(e, giSky.rgb, giGround.rgb, n, giSky.w, giGround.w, giParams.z,
                                lift > 0.0 ? lift : 1.0);
    ratio = mix(vec3(1.0), ratio, rtBounceStrength());

    int debugView = int(giParams.y + 0.5);
    if (debugView != 0) {
        rtGiDebugSet = true;
        if (debugView == 1) rtGiDebugColour = ratio * 0.5;  // grey is an open field
        else if (debugView == 2) rtGiDebugColour = e.rgb;
        else if (debugView == 4) {
            rtGiDebugColour = vec3(giCascadeCover(giVolume[0], worldPos),
                                   giCascadeCover(giVolume[1], worldPos), 0.0);
        }
    }
    return ratio;
}

// The ambient of a surface lit by the zone's light: the flat ambient, the
// traced occlusion, and in Full mode the probes' ratio over it.
vec3 rtAmbient(RtLight r, vec3 flatAmbient, vec3 worldPos, vec3 n) {
    vec3 a = rtAmbient(r, flatAmbient);
    if (giParams.x < 0.5) return a;
    a *= rtGiRatio(worldPos, n);
    if (int(giParams.y + 0.5) == 3) rtGiDebugColour = a;
    return a;
}

vec3 rtGiDebug(vec3 colour) {
    return rtGiDebugSet ? rtGiDebugColour : colour;
}
