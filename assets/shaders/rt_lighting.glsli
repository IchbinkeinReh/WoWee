// Ray traced lighting as the surface shaders read it (RtLighting).
//
// The sun and occlusion were traced last frame, so a surface finds its texels
// by projecting its world position with that frame's matrix, and trusts them
// only where the distance stored there matches its own - anything else is a
// surface that was hidden, off screen or somewhere else last frame. Where
// nothing matches, every term falls back to what the shader computed without
// ray tracing.
//
// The bounced light comes from the probe volume (RtGiProbes, rt_gi.glsli),
// which a surface reads at its own position and normal, so it has no such
// gaps; outside the volume it fades to the flat ambient.
//
// The including shader must declare, in its PerFrame block, viewPos and:
//     mat4 rtViewProj;   // the frame the result was traced in
//     vec4 rtCameraPos;  // its camera position
//     vec4 rtParams;     // x = mode (0 off, 1 sun, 2 +AO, 3 +probe light)
// and after the shadow cascades at its end:
//     vec4 giVolume[2];
//     vec4 giVolumeMod[2];
//     vec4 giSky;        // w = strength
//     vec4 giGround;     // w = largest ratio
//     vec4 giParams;     // x = on, y = debug view, z = chroma

#include "rt_gi.glsli"

layout(set = 0, binding = 3) uniform sampler2D uRtLight;     // r sun, g AO, a distance
layout(set = 0, binding = 4) uniform sampler2D uRtGiProbes;  // the probe atlas

struct RtLight {
    float weight;
    float sun;
    float ao;
};

// The result is traced at half resolution, so a surface's texel neighbours
// can be other surfaces - most of all along an object's silhouette, where a
// single filtered read would average the object with what is behind it, fail
// the distance test and drop the pixel to the fallback: a bright rim. So the
// 3x3 texels around the nearest one are weighed individually, by how close
// they are and whether their stored distance is this surface's, and only the
// matching ones are blended.
RtLight rtLightAt(vec3 worldPos) {
    RtLight r = RtLight(0.0, 1.0, 1.0);
    if (rtParams.x < 0.5) return r;
    vec4 clip = rtViewProj * vec4(worldPos, 1.0);
    if (clip.w <= 0.0) return r;
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return r;

    ivec2 size = textureSize(uRtLight, 0);
    vec2 f = uv * vec2(size) - 0.5;
    ivec2 center = ivec2(floor(f + 0.5));
    float expected = length(worldPos - rtCameraPos.xyz);
    float tolerance = 0.03 * expected + 0.05;

    float wsum = 0.0;
    float best = 0.0;
    vec2 sunAo = vec2(0.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = clamp(center + ivec2(x, y), ivec2(0), size - 1);
            vec4 l = texelFetch(uRtLight, q, 0);
            float e = (l.a - expected) / tolerance;
            float match = l.a > 0.0 ? exp(-e * e) : 0.0;
            vec2 o = vec2(q) - f;
            float w = match * exp(-dot(o, o));
            if (w <= 1e-4) continue;
            best = max(best, match);
            wsum += w;
            sunAo += l.rg * w;
        }
    }
    if (wsum <= 1e-4) return r;
    r.weight = smoothstep(0.1, 0.6, best);
    r.sun = sunAo.x / wsum;
    r.ao = sunAo.y / wsum;
    return r;
}

// Characters are not in the acceleration structure and cast only into the
// shadow map, so the two are combined rather than one replacing the other.
float rtShadow(RtLight r, float shadowMap) {
    return min(shadowMap, mix(1.0, r.sun, r.weight));
}

// The flat ambient darkened by the traced occlusion: for what the probes must
// not light (an interior's own ambient), and the rest of it below Full.
vec3 rtAmbient(RtLight r, vec3 flatAmbient) {
    if (rtParams.x < 1.5) return flatAmbient;
    return mix(flatAmbient, flatAmbient * r.ao, r.weight);
}

// What WOWEE_GI_DEBUG shows instead of the surface, when it shows anything.
vec3 rtGiDebugColour = vec3(0.0);
bool rtGiDebugSet = false;

// How much more or less light than an open field the probes say a surface at
// worldPos facing n gets. The original has no bounced light at all; its
// Light.dbc ambient is the open field's (0x007ee750 and the curves behind
// it), and the artists tuned every zone's colours on that. Taking the probes'
// irradiance as the ambient would throw those colours away - the old
// one-bounce mode did, and darkened everything turned away from the sky. As a
// ratio against the open field (giOpenReference, giAmbientRatio) the probes
// leave a meadow as it was authored at every orientation, and darken the
// underside of a bridge, an alley, a doorway; light a shaded wall from the
// sunlit one across from it; and warm the ground beside a red cliff a little.
vec3 rtGiRatio(vec3 worldPos, vec3 n) {
    vec3 v = normalize(viewPos.xyz - worldPos);
    vec4 e = giIrradiance(uRtGiProbes, giVolume[0], giVolumeMod[0], giVolume[1], giVolumeMod[1],
                          worldPos, n, v);
    vec3 ratio = giAmbientRatio(e, giSky.rgb, giGround.rgb, n, giSky.w, giGround.w, giParams.z);

    int debugView = int(giParams.y + 0.5);
    if (debugView != 0) {
        rtGiDebugSet = true;
        if (debugView == 1) rtGiDebugColour = ratio * 0.5;  // grey is an open field
        else if (debugView == 2) rtGiDebugColour = e.rgb;
        else if (debugView == 4) {
            rtGiDebugColour = vec3(giCascadeCover(giVolume[0], worldPos),
                                   giCascadeCover(giVolume[1], worldPos), 0.0);
        }
    }
    return ratio;
}

// The ambient of a surface lit by the zone's light: the flat ambient, the
// traced occlusion, and in Full mode the probes' ratio over it.
vec3 rtAmbient(RtLight r, vec3 flatAmbient, vec3 worldPos, vec3 n) {
    vec3 a = rtAmbient(r, flatAmbient);
    if (giParams.x < 0.5) return a;
    a *= rtGiRatio(worldPos, n);
    if (int(giParams.y + 0.5) == 3) rtGiDebugColour = a;
    return a;
}

vec3 rtGiDebug(vec3 colour) {
    return rtGiDebugSet ? rtGiDebugColour : colour;
}
