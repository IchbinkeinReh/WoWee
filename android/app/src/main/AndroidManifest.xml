<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The renderer is Vulkan only, and needs 1.2/1.3 entry points that
         Android exports from API 33. A device without them cannot run this. -->
    <uses-feature android:name="android.hardware.vulkan.version"
                  android:version="0x00401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The game data is in a folder the player chooses, /sdcard/wowee by
         default, and the client opens it by path from native code. Only
         all-files access reaches such a folder that way; see
         DataFolderActivity. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- The session stays open while the client is in the background: a
         process holding a foreground service is not frozen, so its socket to
         the world server is not dropped. See WoweeSessionService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/WoweeFullscreen"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:hasFragileUserData="true">

        <!-- The launcher entry: finds the game data, then starts the client. -->
        <activity
            android:name="com.wowee.client.DataFolderActivity"
            android:label="@string/app_name"
            android:theme="@style/WoweeFullscreen"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts"
                       android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name="com.wowee.client.WoweeActivity"
            android:label="@string/app_name"
            android:theme="@style/WoweeFullscreen"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:preferMinimalPostProcessing="true" />

        <!-- Started and stopped by WoweeActivity only. specialUse, because
             none of the named types (media, location, data sync...) is what
             keeping a game connection open is. -->
        <service
            android:name="com.wowee.client.WoweeSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the game server connection open while the app is in the background" />
        </service>
    </application>
</manifest>
